//
// Which stored SHAPE makes the loader read field-at-a-time? Two stores, same payload volume, differing
// only in whether the vector holds SCALARS or RECORDS.
#cwd
struct Pt { x: integer, y: integer }
struct FlatCell { key: integer, xs: vector<integer> }
struct RecCell  { key: integer, ps: vector<Pt> }

fn main() {
  a = arguments();
  which = a[0] ?? "flat";
  path = a[1] ?? "shape.store";
  cells = a[2] as integer ?? 200;
  each = a[3] as integer ?? 250;
  if which == "flat" {
    fw: hash<FlatCell[key]> = [];
    for fi in 0..cells {
      fxs: vector<integer> = [];
      for fj in 0..each { fxs += [fi + fj, fi - fj]; }     // 2 ints per element — same as Pt
      fw += [FlatCell { key: 1000 + fi, xs: fxs }];
    }
    println("flat persist={store_persist_bind(fw, path)}");
  } else {
    rw: hash<RecCell[key]> = [];
    for ri in 0..cells {
      rps: vector<Pt> = [];
      for rj in 0..each { rps += [Pt { x: ri + rj, y: ri - rj }]; }
      rw += [RecCell { key: 1000 + ri, ps: rps }];
    }
    println("record persist={store_persist_bind(rw, path)}");
  }
}
