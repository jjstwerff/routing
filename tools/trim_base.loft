//
// Keep only the tiles whose CELL falls in a longitude band — what makes an independently-built chunk
// disjoint from its neighbours (PLAN-SCALE §6e).
//
// WHY THIS IS NEEDED, and it is not obvious. A chunk is built by running the whole base pipeline over an
// `osmium extract --bbox` of its band. That extract uses the `complete_ways` strategy, so a way with ANY
// node in the box is included WHOLE — which is what keeps geometry intact, and also means a feature
// straddling a chunk boundary lands in BOTH neighbouring extracts.
//
// It is then binned by its FIRST VERTEX (the rule the whole tiling rests on — PLAN-PERF §7g), so it goes
// to the same tile in both chunks. One of those chunks owns that tile; the other has produced a tile
// outside its own band. Left alone, the two chunk stores would share cells: `block_overlap_gate` would
// fail them as a PARTIAL overlap, and a viewport over the seam would read the same buildings twice.
//
// Trimming to the band fixes it exactly, with no arithmetic on geometry: every feature is first-vertexed
// in exactly one band, so across all chunks every feature survives exactly once. That is the property
// `tools/base_chunk_gate.sh` asserts by counting.
//
// The band is HALF-OPEN, [lo, hi) — so adjacent bands sharing an edge value cannot both claim a cell.
//
//   loft --native --lib lib tools/trim_base.loft <in.store> <out.store> <lon_lo> <lon_hi> [cover]
//     lon_lo/lon_hi in degrees; "" or "-999" means unbounded on that side (the first and last chunk).
//
// TWO RULES, because a CHUNK and a REGION want opposite things (PLAN-SCALE §6f F3):
//
//   partition (default)  a tile goes to the band containing its ORIGIN. Every feature survives exactly
//                        once across all bands, which is what re-assembling a chunked build requires and
//                        what `base_chunk_gate.sh` counts.
//   cover     `cover`    a tile goes to every band its sealed EXTENT reaches. Regions are hosted
//                        SEPARATELY and a viewer loads one of them, so each has to be a complete map of
//                        its own ground — a motorway or a province border keyed just across the cut must
//                        appear in both. It duplicates a few coarse tiles on purpose; `partition` would
//                        leave a hole along every seam that only shows up as a missing feature.
#cwd

use basemap::(PTile, Area, Building, Line, Label, Poi, Coord, cell_ix);

fn note_extent(t: PTile, la: integer, lo: integer) {
  if t.fcount == 0 { t.fmnla = la; t.fmxla = la; t.fmnlo = lo; t.fmxlo = lo; }
  else {
    if la < t.fmnla { t.fmnla = la; }
    if la > t.fmxla { t.fmxla = la; }
    if lo < t.fmnlo { t.fmnlo = lo; }
    if lo > t.fmxlo { t.fmxlo = lo; }
  }
  t.fcount += 1;
}

// Each chunk's extent must describe ITS data, not the parent extract's — the index reads it to decide
// which blocks a viewport needs, and an inherited extent would claim ground the chunk does not hold.
fn seal_extents(idx: hash<PTile[tkey]>) {
  for t in idx {
    for sa in t.areas { for ca in sa.ring { note_extent(t, t.oy + (ca.y as integer), t.ox + (ca.x as integer)); } }
    for sb in t.buildings { for cb in sb.ring { note_extent(t, t.oy + (cb.y as integer), t.ox + (cb.x as integer)); } }
    for sl in t.lines { for cl in sl.geom { note_extent(t, t.oy + (cl.y as integer), t.ox + (cl.x as integer)); } }
    for sk in t.labels { for ck in sk.line { note_extent(t, t.oy + (ck.y as integer), t.ox + (ck.x as integer)); } }
    for sp in t.pois { note_extent(t, t.oy + (sp.at.y as integer), t.ox + (sp.at.x as integer)); }
  }
}

fn copy_ring(ring: vector<Coord>) -> vector<Coord> {
  r: vector<Coord> = [];
  for c in ring { r += [Coord { x: c.x, y: c.y }]; }
  r
}

fn copy_into(dst: hash<PTile[tkey]>, src: PTile) -> integer {
  dst += PTile { tkey: src.tkey, ox: src.ox, oy: src.oy, areas: [], buildings: [], lines: [], labels: [], pois: [] };
  t = dst[src.tkey];
  n = 0;
  if t != null {
    for a in src.areas { t.areas += [Area { cover: a.cover, ring: copy_ring(a.ring) }]; n += 1; }
    for b in src.buildings { t.buildings += [Building { name: b.name, ring: copy_ring(b.ring) }]; n += 1; }
    for l in src.lines { t.lines += [Line { kind: l.kind, name: l.name, geom: copy_ring(l.geom) }]; n += 1; }
    for lb in src.labels { t.labels += [Label { name: lb.name, kind: lb.kind, rank: lb.rank, line: copy_ring(lb.line) }]; n += 1; }
    for p in src.pois { t.pois += [Poi { kind: p.kind, name: p.name, at: Coord { x: p.at.x, y: p.at.y } }]; n += 1; }
  }
  n
}

fn main() {
  a: vector<text> = [];
  for x in arguments() { a += [x]; }
  if len(a) < 4 { println("usage: trim_base <in.store> <out.store> <lon_lo> <lon_hi>"); return; }

  CELL_P = 50000;   // the presentation cell — must match client/basemap/build_store.loft
  UNBOUND = 0 - 999;
  lo_deg = (a[2] ?? "") as float ?? (UNBOUND as float);
  hi_deg = (a[3] ?? "") as float ?? (UNBOUND as float);
  // The CELL a boundary falls in, so a tile is never cut — the same treatment `split_base` gives its
  // meridian. Comparing cells rather than degrees is what keeps chunk edges exact.
  lo_cell = 0 - 1000000000;
  hi_cell = 1000000000;
  if lo_deg > (UNBOUND as float) { lo_cell = cell_ix(round(lo_deg * 10000000.0) as integer, CELL_P); }
  if hi_deg > (UNBOUND as float) { hi_cell = cell_ix(round(hi_deg * 10000000.0) as integer, CELL_P); }

  cover = (a[4] ?? "") == "cover";

  // ⚠ `store_persist_bind` ADOPTS AN EXISTING IMAGE. Pointed at a file that already exists it keeps the
  // old contents, writes none of the new ones, and still returns TRUE — so a re-run silently produces
  // the previous answer. It cost a wrong three-region cut on 2026-08-01: the trim reported the new
  // feature counts, `persist true`, a fresh mtime, and the file still held the old map.
  if file(a[1] ?? "").exists() {
    println("#PERSIST FAIL {a[1] ?? ""} already exists — store_persist_bind would keep the OLD image and report success. Remove it first.");
    return;
  }
  src: hash<PTile[tkey]> = [];
  if !store_load(src, a[0] ?? "") { println("#T FAIL store_load"); return; }

  out: hash<PTile[tkey]> = [];
  kept = 0; dropped = 0; kf = 0; df = 0;
  for t in src {
    n = 0;
    for ca in t.areas { n += 1; }
    for cb in t.buildings { n += 1; }
    for cl in t.lines { n += 1; }
    for ck in t.labels { n += 1; }
    for cp in t.pois { n += 1; }
    // `cover` asks where the tile's GEOMETRY reaches; the default asks where its origin is. On a tiered
    // store the two differ for exactly the tiles that matter: a coarse tile's origin is the corner of a
    // cell that can be hundreds of km wide, so an origin test drops it from every region but one.
    take = false;
    if cover {
      if t.fcount > 0 {
        take = cell_ix(t.fmxlo, CELL_P) >= lo_cell && cell_ix(t.fmnlo, CELL_P) < hi_cell;
      } else {
        take = cell_ix(t.ox, CELL_P) >= lo_cell && cell_ix(t.ox, CELL_P) < hi_cell;
      }
    } else {
      take = cell_ix(t.ox, CELL_P) >= lo_cell && cell_ix(t.ox, CELL_P) < hi_cell;
    }
    if take { kept += 1; kf += copy_into(out, t); }
    else { dropped += 1; df += n; }
  }
  seal_extents(out);
  ok = store_persist_bind(out, a[1] ?? "");
  println("#T band [{lo_deg},{hi_deg}) cells [{lo_cell},{hi_cell}) · kept tiles={kept} features={kf} · dropped tiles={dropped} features={df} · persist {ok}");
}
