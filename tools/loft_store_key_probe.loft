//
// UPSTREAM BUG PROBE — loft-lang/loft#739. A keyed lookup on a store bound with `store_persist_bind`
// PANICKED the runtime (`--native` only; the interpreter answered correctly):
//
//   thread '<unnamed>' panicked at src/database/search.rs:229:37:
//   find called on non-collection type: <varies> (db=128)
//
// Fixed upstream 2026-08-03, and binding itself is gone since (loft removed `store_persist_bind`,
// 2026-11). What is left to guard is the lookup the bug was about: a keyed read on a POPULATED store
// that came from a file, which is now a `store_load`. The regression guard keeps its markers so
// `tools/loft_bug_gate.sh` reads it unchanged.
//
//   loft --native --lib lib tools/loft_store_key_probe.loft <block.store>
//
// ⚠ A BARE LOCAL. This bound through `struct Block { roads: … }` while binding existed; a load into a
// wrapper field is refused for a file written from a bare `hash<TTile[tkey]>` (loft#757), so the wrapper
// would only measure that refusal. Loading never writes, so the committed fixture is safe to point at;
// `tools/loft_bug_gate.sh` still copies it first.
#cwd

use routing_kernel::(TTile, TRoad, TStep);

fn main() {
  a: vector<text> = [];
  for x in arguments() { a += [x]; }
  path = a[0] ?? "";
  if path == "" { println("#P SKIP usage: loft_store_key_probe <block.store>  — point it at a COPY"); return; }
  if !file(path).exists() { println("#P SKIP no block at {path}"); return; }

  roads: hash<TTile[tkey]> = [];
  ok = store_load(roads, path);
  n = 0;
  key = 0;
  for t in roads { n += 1; if key == 0 { key = t.tkey; } }
  println("#P loaded={ok} tiles={n} first key={key}");
  if !ok { println("#P SKIP could not load {path} — the reason is on stderr (a block from an older loft?)"); return; }
  if n == 0 { println("#P SKIP the store is empty — the lookup only aborts on a populated one"); return; }

  println("#P about to look that key up — this is the line that aborts");
  t2 = roads[key];
  println("#P FIXED — lookup returned null={t2 == null}, no panic");
}
