//
// Split a roads block in two along a meridian (PLAN-SCALE C2 / S7 / S8).
//
// WHY. Every multi-block property — the index resolving between blocks, a working set filled from more
// than one, a route crossing a seam — needs TWO blocks, and the real second block is a country-sized
// generation away. Splitting the one we have produces a genuine seam over data whose correct answer is
// already known: the same corridor, matched against the whole block, is the reference the split must
// reproduce. A seam that only appears with real NL data would be found late and debugged blind.
//
// The split is by CELL, never by geometry: a tile goes wholly to one side, so no way is cut and no
// coordinate changes. The seam therefore falls exactly on a cell boundary — which is the same seam a
// real per-region generation produces, because regions are cut on cell boundaries too.
//
//   loft --native --lib lib tools/split_block.loft <in.store> <west.store> <east.store> <lon_deg>
#cwd

use routing_kernel::(TTile, TBarrier, TRoad, TStep, TRoute, TRLink, cell_ix);

fn copy_barriers(src: TTile) -> integer { n = 0; for _b in src.barriers { n += 1; } n }

fn copy_into(dst: hash<TTile[tkey]>, src: TTile) -> integer {
  dst += TTile { tkey: src.tkey, ox: src.ox, oy: src.oy, oh: src.oh, roads: [], steps: [] };
  t = dst[src.tkey];
  n = 0;
  if t != null {
    for r in src.roads { t.roads += [TRoad { tp: r.tp, flags: r.flags, nets: r.nets, steps: r.steps }]; n += 1; }
    for s in src.steps { t.steps += [TStep { x: s.x, y: s.y, h: s.h }]; }
    // ⚠ EVERY collection, or the split silently loses one. Barriers were added to TTile after this tool
    // was written, and a copier that omits a field does not fail — it produces a smaller, wronger block.
    for b in src.barriers { t.barriers += [TBarrier { x: b.x, y: b.y, flags: b.flags }]; }
    // PLAN-LAYERS §3 — the route table and its links. ⚠ `TRLink.road` is an index into THIS tile's
    // `roads`, so a copier may only carry them verbatim while it copies every road in order, which is
    // what the loop above does. A copier that ever FILTERS roads must remap these, not copy them.
    for rt in src.routes { t.routes += [TRoute { rid: rt.rid, kind: rt.kind, level: rt.level, flags: rt.flags,
                                                colour: rt.colour, rref: rt.rref, name: rt.name }]; }
    for rl in src.rlinks { t.rlinks += [TRLink { road: rl.road, route: rl.route }]; }
  }
  n
}

fn main() {
  a: vector<text> = [];
  for x in arguments() { a += [x]; }
  if len(a) < 4 { println("usage: split_block <in.store> <west.store> <east.store> <lon_deg>"); return; }
  lon = (a[3] ?? "0") as float ?? 0.0;
  cut = cell_ix(round(lon * 10000000.0) as integer);   // the CELL the split falls in, so tiles stay whole

  src: hash<TTile[tkey]> = [];
  // ⚠ `store_persist_bind` ADOPTS AN EXISTING IMAGE. Pointed at a file that already exists it keeps the
  // old contents, writes none of the new ones, and still returns TRUE — so a re-run silently produces
  // the previous answer. It cost a wrong three-region cut on 2026-08-01: the trim reported the new
  // feature counts, `persist true`, a fresh mtime, and the file still held the old map.
  if file(a[1] ?? "").exists() {
    println("#PERSIST FAIL {a[1] ?? ""} already exists — store_persist_bind would keep the OLD image and report success. Remove it first.");
    return;
  }
  if file(a[2] ?? "").exists() {
    println("#PERSIST FAIL {a[2] ?? ""} already exists — store_persist_bind would keep the OLD image and report success. Remove it first.");
    return;
  }
  store_load(src, a[0] ?? "");

  west: hash<TTile[tkey]> = [];
  east: hash<TTile[tkey]> = [];
  wt = 0; et = 0; wr = 0; er = 0; sb = 0; wb = 0; eb = 0;
  for t in src {
    sb += copy_barriers(t);
    if cell_ix(t.ox) < cut { wt += 1; wr += copy_into(west, t); wb += copy_barriers(t); }
    else { et += 1; er += copy_into(east, t); eb += copy_barriers(t); }
  }
  println("split at cell {cut} ({lon}): west tiles={wt} roads={wr} barriers={wb} · east tiles={et} roads={er} barriers={eb}");
  // CONSERVATION, asserted. A copier that omits a field does not fail, it produces a smaller block —
  // which is exactly what happened when `barriers` was added to TTile and this tool still copied only
  // roads and steps. Counting both sides against the source is the check that would have caught it.
  if wb + eb != sb {
    println("FAIL: {sb} barriers in, {wb}+{eb}={wb + eb} out — the split is DROPPING a field");
    return;
  }
  if wt == 0 || et == 0 {
    println("FAIL: the split put every tile on one side — pick a longitude inside the block");
    return;
  }
  println("west persist {store_persist_bind(west, a[1] ?? \"\")}");
  println("east persist {store_persist_bind(east, a[2] ?? \"\")}");
}
