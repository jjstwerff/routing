//
// Do two road blocks hold the same CELL? (PLAN-SCALE C2/S7 — the disjointness the index cannot check.)
//
// A corridor names every block whose extent it touches, and reads the same cell window from each. If two
// blocks hold that cell, the same roads reach `build_graph` twice — and a duplicated way is not reliably a
// slower match, it is a different one. It survived once only because nodes dedup by coordinate: with
// Enschede listed inside the Netherlands, 7,138 ways became 9,438 for an identical route.
//
// ⚠ The test is CELL SETS, not bounding boxes. Extents legitimately overlap: a tile's extent is the union
// of its features' coordinates, and a feature is keyed by its FIRST VERTEX and never clipped, so a way
// starting just west of a seam reaches east of it. Overlapping extents are normal; a shared cell is the
// defect. Comparing boxes would fail on every correctly-cut pair.
//
// Blocks generated by splitting one extract on cell boundaries are disjoint by construction. Blocks taken
// from per-country extracts are NOT — Geofabrik deliberately includes cross-border data — which is the
// case this gate exists to catch before a continent is generated on top of it.
//
//   loft --native --lib lib tools/block_overlap.loft <a.roads.store> <b.roads.store> [more…]
#cwd

use routing_kernel::TTile;

// One cell, and which block claimed it first. `dups` counts later claims so the report can say how bad it
// is rather than only that it happened.
struct Owner { const k: integer, first: integer, dups: integer }

fn main() {
  paths: vector<text> = [];
  for x in arguments() { paths += [x]; }
  if len(paths) < 2 { println("usage: block_overlap <a.store> <b.store> [more…]"); return; }

  seen: hash<Owner[k]> = [];
  counts: vector<integer> = [];
  overlaps = 0;
  worst_a = 0 - 1; worst_b = 0 - 1;

  bi = 0;
  for p in paths {
    tiles: hash<TTile[tkey]> = [];
    store_load(tiles, p);
    n = 0;
    for t in tiles {
      n += 1;
      o = seen[t.tkey];
      if o == null {
        seen += Owner { k: t.tkey, first: bi, dups: 0 };
      } else {
        o.dups += 1;
        overlaps += 1;
        if worst_a < 0 { worst_a = o.first; worst_b = bi; }
      }
    }
    counts += [n];
    println("  block {bi}: {n} cells  ({p})");
    bi += 1;
  }

  total = 0;
  for c in counts { total += c; }
  if total < 2 {
    println("#O FAIL vacuous — fewer than two cells in total, so nothing was compared");
    return;
  }
  if overlaps > 0 {
    println("#O FAIL — {overlaps} cell(s) held by more than one block (first clash: block {worst_a} and block {worst_b})");
    println("     A corridor over a shared cell reads those roads TWICE and matches a different route.");
    println("     Cut the regions on cell boundaries from one extract (tools/split_block.loft), rather");
    println("     than taking them from per-country extracts, which overlap at every border.");
    return;
  }
  println("#O ALL PASS — {len(paths)} blocks, {total} cells, no cell held by two blocks");
}
