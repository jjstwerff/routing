//
// gen-tiles — build a PLAN-TILES data block (hash<TTile[tkey]>) from OpenStreetMap.
// Input: Overpass-JSON (elements[].{type:"way", tags, geometry:[{lat,lon},…]}), which you produce
// from a Geofabrik .osm.pbf via osmium + tools/geojson2overpass.py (see HANDOFF.md / PLAN-APP §11).
//   loft --native-release --lib lib tools/gen-tiles.loft <out.tiles> <overpass.json> [networks]
// The optional third argument is `tools/route_networks.py`'s way→network sidecar; omit it and the block
// carries no RF_NET_* bits, which is exactly the pre-R3 behaviour.
// NOTE: writes an mmap store via store_persist_bind — native only; wasm loads via a codec (PLAN-APP §3).
// Regenerate blocks whenever loft's store format changes (loft#513 changed it — old .tiles read empty).
#cwd                          // CLI tool: <out.tiles> / <overpass.json> resolve against the working dir

use routing_kernel::(GeoPoint, Way, Barrier, parse_ways, parse_way_feature, parse_barrier_feature,
                     TStep, TRoad, TTile, TBarrier, TRoute, TRLink, cell_ix, tile_cell_key,
                     RF_CYCLEWAY, RF_UNPAVED, RF_ACCESS_NO, RF_BIKE_NO, RF_BIKE_YES, RF_FOOT_NO, RF_FOOT_YES, RF_SVC_LOCAL,
                     oneway_flags);

// One way that carries at least one signposted route, from `tools/route_networks.py`'s sidecar.
// A struct because loft keys a hash by a FIELD.
//
// ⚠ ONE NUMBERING NOW (PLAN-LAYERS §3). The sidecar's mask, `TRoad.nets` and the wire all use NET_*
// (1/2/4/8/16), so the mask is STORED, not translated. It used to be mapped to a second numbering in
// `flags`' high bits, deliberately, so that a change to the stored layout could not silently
// reinterpret an already-generated sidecar — a seam that is no longer needed once there is one layout.
struct NetWay { const wid: integer, const mask: integer, const rids: vector<integer> }

// One ROUTE, as the sidecar's `R` records describe it. `rref` rather than `ref` because `ref` is not
// available as a field name here, and the store's TRoute uses the same spelling.
struct RouteRec { const rid: integer, const kind: integer, const level: integer, const flags: integer,
                  const colour: text, const rref: text, const name: text }

// Both halves of the sidecar. A struct because a function returns one value and a hash must be a field.
struct Sidecar { const ways: hash<NetWay[wid]>, const routes: hash<RouteRec[rid]> }

fn kind_bit(kind: text) -> integer {
  if kind == "walk" { return 1; }
  if kind == "cycle" { return 2; }
  if kind == "mtb" { return 4; }
  if kind == "horse" { return 8; }
  if kind == "skate" { return 16; }
  0
}

// The sidecar, in the three line kinds `route_networks.py` writes:
//
//   R<TAB>rid<TAB>kind<TAB>level<TAB>flags<TAB>colour<TAB>ref<TAB>name
//   <wayid> <mask>                                        (the legacy line, unchanged)
//   M<TAB>wayid<TAB>rid,rid,…
//
// An ABSENT file is not an error: a block generated without one simply has no network bits, and every
// route it produces is exactly what it was before R3. An OLDER sidecar (v1, way lines only) is not an
// error either — it yields masks and no route table, which is the map this repo shipped until now.
fn load_networks(path: text) -> Sidecar {
  sc = Sidecar { ways: [], routes: [] };
  if path == "" { return sc; }
  f = file(path);
  if !f.exists() { println("networks: no sidecar at {path} — block will carry no network bits"); return sc; }
  n = 0; nroutes = 0; nlinks = 0;
  for ln in f.content()?.split('\n') {
    if ln == "" { continue; }
    if ln[0..1] == "#" { continue; }
    if ln[0..2] == "R\t" {
      c: vector<text> = [];
      for fld in ln.split('\t') { c += [fld]; }
      if len(c) >= 8 {
        sc.routes += RouteRec { rid: (c[1] ?? "") as integer ?? 0, kind: kind_bit(c[2] ?? ""),
                                level: (c[3] ?? "") as integer ?? 0, flags: (c[4] ?? "") as integer ?? 0,
                                colour: c[5] ?? "", rref: c[6] ?? "", name: c[7] ?? "" };
        nroutes += 1;
      }
      continue;
    }
    if ln[0..2] == "M\t" {
      c2: vector<text> = [];
      for fld2 in ln.split('\t') { c2 += [fld2]; }
      if len(c2) >= 3 {
        wid2 = (c2[1] ?? "") as integer ?? 0;
        w2 = sc.ways[wid2];
        if w2 != null {
          for rtxt in (c2[2] ?? "").split(',') {
            rid2 = rtxt as integer ?? 0;
            if rid2 > 0 { w2.rids += [rid2]; nlinks += 1; }
          }
        }
      }
      continue;
    }
    sp = 0 - 1;
    for ch in ln { if ch == ' ' { sp = ch#index; break; } }
    if sp <= 0 { continue; }
    wid = ln[0..sp] as integer ?? 0;
    mask = ln[(sp + 1)..ln.size()] as integer ?? 0;
    if wid > 0 && mask > 0 { sc.ways += NetWay { wid: wid, mask: mask, rids: [] }; n += 1; }
  }
  println("networks: {n} ways, {nroutes} routes, {nlinks} memberships from {path}");
  sc
}

fn class_of(hw: text) -> integer {
  if hw == "motorway" || hw == "motorway_link" { return 0; }
  if hw == "trunk" || hw == "trunk_link" || hw == "primary" || hw == "primary_link" { return 1; }
  if hw == "secondary" || hw == "secondary_link" { return 2; }
  if hw == "tertiary" || hw == "tertiary_link" || hw == "unclassified" { return 3; }
  if hw == "residential" { return 4; }
  if hw == "living_street" { return 5; }
  if hw == "service" { return 6; }
  if hw == "cycleway" { return 7; }
  if hw == "path" || hw == "bridleway" { return 8; }
  // `track` was folded into `path` here, and class 12 sat unused. A dirt road is not a footpath: the
  // cost model tests `hw == "track"` in four places (all dead on tile-sourced ways while the two
  // shared a class), and the browser styles `track` at minZoom 14 against `path`'s 15 — so every
  // farm track in the data was simply not drawn at zoom 14. It looked like missing data and was a
  // collapsed class.
  if hw == "track" { return 12; }
  if hw == "footway" { return 9; }
  if hw == "pedestrian" { return 10; }
  if hw == "steps" { return 11; }
  if hw == "busway" { return 13; }
  if hw == "platform" { return 14; }
  15
}

// Pack the tags the cost model tests into the one flags byte (see routing_kernel's RF_* block for why
// each bit exists, and what it costs to leave one out).
fn flags_of(w: Way) -> integer {
  f = 0;
  if w.cyclestreet == "yes" || w.cycleway == "lane" || w.cycleway == "track" { f = f + RF_CYCLEWAY; }
  s = w.surface;
  if s == "ground" || s == "gravel" || s == "unpaved" || s == "compacted" { f = f + RF_UNPAVED; }
  a = w.access;
  if a == "no" || a == "private" { f = f + RF_ACCESS_NO; }
  b = w.bicycle;
  if b == "no" || b == "private" || b == "use_sidepath" { f = f + RF_BIKE_NO; }
  else if b == "yes" || b == "designated" || b == "permissive" { f = f + RF_BIKE_YES; }
  ft = w.foot;
  if ft == "no" || ft == "private" { f = f + RF_FOOT_NO; }
  else if ft == "yes" || ft == "designated" || ft == "permissive" { f = f + RF_FOOT_YES; }
  sv = w.svc;
  if sv == "driveway" || sv == "alley" || sv == "parking_aisle" { f = f + RF_SVC_LOCAL; }
  // Direction, in bits 8–11 (PLAN-SCALE §9 item 7). The encoding lives in routing_kernel beside the
  // decoder that reads it back, so the two cannot drift — the generator does not know the bit layout.
  f = f + oneway_flags(w.oneway, w.onewaybike);
  f
}
CELL = 200000;   // must equal routing_kernel's TILE_CELL — cell_ix/tile_cell_key are keyed to it

// Bin ONE way into its tile. Shared by both input paths so a streamed input and a whole-file one cannot
// produce different stores — which is exactly what the round-trip gate checks (tools/gen_stream_gate.sh).
// By VALUE, not `&`: a heap collection passed by value still aliases, so the append lands in the
// caller's index (verified). `&hash` + `+=` does not compile — the checker reads the append as a
// reassignment of the reference itself.
// Where a route lands in THIS tile's own table — appending it if this is the first road here on it.
//
// A linear scan, deliberately: a tile holds a few hundred roads and tens of routes, and the alternative
// is a second keyed collection per tile that the store would have to carry for the generator's benefit.
// The index it returns is what `TRLink.route` means, which is why it must never be computed anywhere
// else — a link is only meaningful against the table it was made for.
// ⚠ WALKED BY INDEX, NOT WITH `for existing in t.routes`. Iterating a collection yields COPIES (loft
// C86), and a copy of a TRoute copies its THREE text fields — so the obvious loop duplicated three
// strings per candidate per membership, 945 000 memberships deep. Measured: the country run was still
// inside this function after 12 minutes of CPU with no output; by index it is a live view and the
// comparison reads one integer. This repo has paid for the same trap once already — `gen-names` copied
// 618 000 strings per keystroke and took 5.4 s natively on the country store.
fn route_slot(t: TTile, r: RouteRec) -> integer {
  n = len(t.routes);
  i = 0;
  while i < n {
    existing = t.routes[i];
    if existing != null && existing.rid == r.rid { return i; }
    i += 1;
  }
  t.routes += [TRoute { rid: r.rid, kind: (r.kind & 255) as u8, level: (r.level & 255) as u8,
                        flags: (r.flags & 255) as u8, colour: r.colour, rref: r.rref, name: r.name }];
  i
}

fn add_way(idx: hash<TTile[tkey]>, w: Way, net: integer, rids: vector<integer>, routes: hash<RouteRec[rid]>) {
  if len(w.coords) < 2 { return; }
  gx0 = round(w.coords[0].lon * 10000000.0) as integer;
  gy0 = round(w.coords[0].lat * 10000000.0) as integer;
  // The kernel looks tiles up by key (PLAN-SCALE C1a), so this MUST be its packing — imported, not
  // re-derived. It used to be `ty * 1000000 + tx` over truncating division, which collides west of
  // Greenwich and at finer cells (see routing_kernel's note and client/basemap/grid_test.loft).
  tx = cell_ix(gx0); ty = cell_ix(gy0);
  key = tile_cell_key(tx, ty);
  t = idx[key];
  if t == null {
    idx += TTile { tkey: key, ox: tx * CELL, oy: ty * CELL, oh: 0, roads: [], steps: [] };
    t = idx[key];
  }
  n = len(w.coords); if n > 255 { n = 255; }
  for i in 0..n {
    gx = round(w.coords[i].lon * 10000000.0) as integer;
    gy = round(w.coords[i].lat * 10000000.0) as integer;
    t.steps += [TStep { x: (gx - t.ox) as i32? ?? (0 as i32), y: (gy - t.oy) as i32? ?? (0 as i32), h: 0 as i32 }];
  }
  t.roads += [TRoad { tp: (class_of(w.highway) & 255) as u8, flags: (flags_of(w) & 65535) as u16,
                      nets: (net & 65535) as u16, steps: (n & 255) as u8 }];
  // PLAN-LAYERS §3 — WHICH routes, not just whether. The link is made against the road just appended,
  // so its index is `len(t.roads) - 1`; a tile's links are therefore in road order by construction, which
  // is what lets every copier carry them verbatim.
  ri = len(t.roads) - 1;
  if ri >= 0 && ri <= 65535 {
    for rid in rids {
      rec = routes[rid];
      if rec != null {
        slot = route_slot(t, rec);
        if slot > 65535 { continue; }        // a tile with 65 536 distinct routes cannot happen; say so
        // `& 65535` rather than a checked cast: the guards above already bound both, and the mask is
        // what makes that visible to the compiler as well as to the reader.
        t.rlinks += [TRLink { road: (ri & 65535) as u16, route: (slot & 65535) as u16 }];
      }
    }
  }
}

// Bin ONE barrier node into the tile that CONTAINS it. Unlike a way — keyed by its first vertex and free
// to overhang its cell — a point falls squarely in one cell, so no margin is involved.
//
// A barrier in a cell that holds no roads still gets a tile: the corridor read looks tiles up by key, and
// a barrier the read cannot reach is a barrier the router does not apply. (Rare, and cheap when it
// happens — a tile with an empty roads vector.)
fn add_barrier(idx: hash<TTile[tkey]>, b: Barrier) {
  if b.lat == 0.0 && b.lon == 0.0 { return; }    // not a barrier point
  // ⚠ EVERY barrier is stored, including the ones that stop nobody we route. It used to drop `flags == 0`
  // — correct while the block existed only to route on, and wrong the moment the MAP started drawing
  // barriers: 1565 of 2554 nodes in this region are bollards, cattle grids, cycle barriers and unlocked
  // gates, and dropping them meant the renderer's "a gate you can open" mark had no data to draw. A
  // cattle grid 59 m from a reported spot was simply not in the block.
  //
  // Safe for routing by construction: `apply_barriers` skips `flags == 0`, so the graph is unchanged.
  gx = round(b.lon * 10000000.0) as integer;
  gy = round(b.lat * 10000000.0) as integer;
  btx = cell_ix(gx); bty = cell_ix(gy);
  bkey = tile_cell_key(btx, bty);
  bt = idx[bkey];
  if bt == null {
    idx += TTile { tkey: bkey, ox: btx * CELL, oy: bty * CELL, oh: 0, roads: [], steps: [], barriers: [] };
    bt = idx[bkey];
  }
  bt.barriers += [TBarrier { x: (gx - bt.ox) as i32? ?? (0 as i32), y: (gy - bt.oy) as i32? ?? (0 as i32),
                             flags: (b.flags & 255) as u8 }];
}

// WHOLE-FILE input: one Overpass JSON document. Fine for a city, impossible for a country — the document
// arrives as a single `text` value and `parse_ways` materialises every way before the first is binned.
fn build(osm: text) -> hash<TTile[tkey]> {
  idx: hash<TTile[tkey]> = [];
  // No network join on this path: Overpass JSON carries no stable way id here, and the whole-file reader
  // is the city-sized legacy path. It stays byte-identical to what it produced before R3.
  none: vector<integer> = [];
  noroutes: hash<RouteRec[rid]> = [];
  for w in parse_ways(file(osm).content()) { add_way(idx, w, 0, none, noroutes); }
  idx
}

// STREAMED input: `geojsonseq`, one GeoJSON Feature per line (PLAN-SCALE S6, W1).
//
// loft's `lines()` is built on `content()`, so both hold the whole file; the binary idiom seeks instead.
// Each pass reads a chunk, uses only the part up to its LAST newline, and seeks back to just after it —
// so a chunk boundary can never split a line, and never leaves a partial multi-byte character to decode.
// Memory is the chunk, whatever the file. A line longer than the chunk doubles it and retries.
// One `geojsonseq` record, whichever kind it is. osmium writes linestrings and points into ONE file, and
// each parser returns its own "not mine" answer cheaply (a Way with <2 coords, a Barrier at 0,0), so the
// dispatch needs no separate type sniff.
fn feed(idx: hash<TTile[tkey]>, line: text, sc: Sidecar, hits: &integer) {
  w = parse_way_feature(line);
  if len(w.coords) >= 2 {
    net = 0;
    rids: vector<integer> = [];
    // `w.wid` is 0 unless the export was run with `-u type_id`, and the lookup then simply misses.
    nw = sc.ways[w.wid];
    if nw != null {
      net = nw.mask;                      // stored as-is: one numbering, sidecar to store to wire
      if net != 0 { hits = hits + 1; }
      for rid in nw.rids { rids += [rid]; }
    }
    add_way(idx, w, net, rids, sc.routes);
    return;
  }
  add_barrier(idx, parse_barrier_feature(line));
}

fn build_stream(path: text, netpath: text) -> hash<TTile[tkey]> {
  idx: hash<TTile[tkey]> = [];
  sc = load_networks(netpath);
  hits = 0;
  f = file(path);
  total = f.size;
  pos = 0;
  chunk_size = 1048576;
  nlines = 0;
  while pos < total {
    f#next = pos;
    want = chunk_size;
    if pos + want > total { want = total - pos; }
    chunk = f#read(want) as text;
    last_nl = 0 - 1;
    for ch in chunk { if ch == '\n' { last_nl = ch#index; } }
    if last_nl < 0 {
      if pos + want >= total {
        if chunk != "" { feed(idx, chunk, sc, hits); nlines += 1; }
        pos = total;
      } else {
        chunk_size = chunk_size * 2;      // one line is longer than the chunk — grow and re-read
      }
    } else {
      part = chunk[0..last_nl];
      for ln in part.split('\n') {
        if ln != "" { feed(idx, ln, sc, hits); nlines += 1; }
        // A country is ~20M features and this loop used to print nothing until it finished, so a stall
        // and a slow run looked identical from the outside. They are not the same thing and the
        // difference decides whether you wait or investigate.
        if nlines % 2000000 == 0 { println("  … {nlines} features, {hits} on a network"); }
      }
      pos = pos + last_nl + 1;
    }
  }
  println("streamed: {nlines} features from {total} bytes in {chunk_size}-byte chunks");
  // Reported, because the join is silent when it fails: a sidecar for the wrong region, or an export
  // built without `-u type_id`, both produce a perfectly valid block with every network bit clear.
  // `networks: N ways` followed by `matched: 0` is the signature of that, and the gate asserts on it.
  println("networks matched: {hits} ways in this block");
  idx
}
fn main() {
  a = arguments();
  src = a[1] ?? "";
  // The FORM of the input picks the reader: `.geojsonseq` / `.jsonl` stream line by line, anything else
  // is the whole-document Overpass path. PLAN-TILES' recipe already ends in `osmium export -f geojsonseq`
  // and then converts; streaming reads that file directly, which removes the conversion step entirely.
  idx: hash<TTile[tkey]> = [];
  if src.ends_with(".geojsonseq") || src.ends_with(".jsonl") { idx = build_stream(src, a[2] ?? ""); }
  else { idx = build(src); }
  nt = 0; nr = 0; nb = 0; nrt = 0; nrl = 0;
  for t in idx { nt = nt + 1; nr = nr + len(t.roads); nb = nb + len(t.barriers);
                 nrt = nrt + len(t.routes); nrl = nrl + len(t.rlinks); }
  // routes are counted PER TILE, so a route crossing many tiles is counted in each — that duplication is
  // the price of a reader that never leaves the tile it already holds, and printing it is how it stays
  // a known price rather than a surprise in the block's size.
  println("built: tiles={nt} roads={nr} barriers={nb} route-records={nrt} links={nrl}");
  ok = store_persist_bind(idx, a[0]);
  println("persist {ok}");
}
