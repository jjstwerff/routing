//
// FILL IN THE HEIGHT OF EVERY STORED STEP, from terrain sampled on the BUILD MACHINE (PLAN-RESTORE R2).
//
// `TStep` has carried `h: i32` since the tile format existed, and `tools/gen-tiles.loft` has written `0`
// into every one of them. The old client got its elevation profile from the server fetching AWS terrarium
// PNGs per request — exactly the shape an offline app cannot have. Under this repo's rule height belongs
// in the block: sampled once, at generation, and never fetched again.
//
// ⚠ IT COSTS THE BLOCK NOTHING. `h` is already in the schema and already occupies its four bytes in every
// TStep record, so filling it changes no layout, no stride and no file size. This is NOT a schema change:
// older blocks stay readable, loft#700 does not apply, and a regeneration buys only the DATA.
//
//   loft --native --lib lib tools/gen_heights.loft <block.store> <grid.hgt>
//
// The grid is what `tools/pack_terrain.py` writes from the PNG cache `tools/fetch-terrain.sh` fills.
// Nothing here touches the network or decodes an image: a sample is a seek and a two-byte read, and a
// coordinate outside the grid (or in a tile the cache never had) keeps its zero and is COUNTED, so a
// half-covered block reports itself instead of publishing as finished.
//
// ⚠ IT EDITS THE BLOCK IN PLACE, and it is the ONE tool here that WANTS `store_persist_bind` to adopt an
// existing image. Everywhere else that is the hazard the `#PERSIST FAIL` guards exist for. Here adopting
// IS the operation — the block is opened, its steps are given heights, and the same file is written back.
// That makes it IDEMPOTENT: the same grid gives the same heights, so a run that dies half way is fixed by
// running it again, not by regenerating the block.
#cwd

use routing_kernel::(TTile, TRoad, TStep, tile_xf, tile_yf);

TILE_PX = 256;             // a terrarium tile is 256x256 samples
UNIT = 10000000.0;         // fixed-point units per degree (1e-7°), as TTile stores them
HDR_BYTES = 24;            // "LTH1" + zoom, x0, y0, cols, rows — see pack_terrain.py

// ⚠ NO WRAPPER STRUCT. `store_persist_bind` RECORDS THE BINDING PROGRAM'S OWN ROOT SHAPE in the
// `.dschema` sidecar, so binding through a `struct Block { roads: … }` rewrote the sidecar to name it and
// changed the schema hash — after which loft#705 makes every OTHER tool fail to load the block, because
// they all bind a bare `hash<TTile[tkey]>` (gen-tiles, split_block, store_extent, cell_diff, the lot).
//
// Measured on a copy of the Enschede fixture, 2026-08-03, loft 2026.8.0 md5 276cf8f9: heights filled
// 289 117/289 117 and the block was then unreadable — `store_extent` returned 0 0 0 0 0 0. The damage is
// SIDECAR-ONLY (the records are intact and correct), which is what makes it survivable and also what
// makes it invisible: the tool that caused it can still read its own output.
//
// It breaks the refresh: `refresh-region.sh` bakes heights at step 2 and cuts regions at step 5, and the
// cut cannot load what the bake left behind. `tools/reseat_schema.loft` is the recovery for a block that
// already has it.

// Where the packed grid starts and how it is laid out. `present` is one byte per tile: it is what tells
// "the cache never had this tile" apart from "this tile is at sea level", and the Netherlands is full of
// legitimate zeroes — a zero sentinel would have reported the whole country as flat and plausible.
struct Grid {
  zoom: integer, x0: integer, y0: integer, cols: integer, rows: integer,
  present: vector<integer>,
}

// Height in whole metres at a coordinate, or null when the grid does not cover it.
fn grid_h(f: File, g: Grid, lat: float, lon: float) -> integer? {
  xf = tile_xf(lon, g.zoom);
  yf = tile_yf(lat, g.zoom);
  tx = floor(xf) as integer;
  ty = floor(yf) as integer;
  cx = tx - g.x0;
  cy = ty - g.y0;
  if cx < 0 || cy < 0 || cx >= g.cols || cy >= g.rows { return null; }
  ti = cy * g.cols + cx;
  if ti >= len(g.present) { return null; }
  pv = g.present[ti] ?? 0;
  if pv == 0 { return null; }
  sx = floor((xf - (tx as float)) * (TILE_PX as float)) as integer;
  sy = floor((yf - (ty as float)) * (TILE_PX as float)) as integer;
  if sx >= TILE_PX { sx = TILE_PX - 1; }
  if sy >= TILE_PX { sy = TILE_PX - 1; }
  if sx < 0 { sx = 0; }
  if sy < 0 { sy = 0; }
  f#next = (HDR_BYTES + g.cols * g.rows + (ti * TILE_PX * TILE_PX + sy * TILE_PX + sx) * 2) as integer;
  // One signed little-endian 2-byte sample, which is what the grid stores. `#format` above makes the
  // endianness the handle's business and `i16` sign-extends, so neither is done by hand here.
  //
  // This was two `u8` reads recombined until 2026-08-03: loft#739 made exactly one sized read width come
  // back NULL, silently, in a `--native` program declaring a hash over a library-imported struct — which
  // this one must, to bind the block — and that width was `i16`. It read as "0 of 289 117 steps got a
  // height" against a grid whose header the same handle had just parsed correctly. Fixed upstream;
  // `tools/loft_bug_gate.sh` is what re-checks it, per binary.
  v = f#read as i16;
  if v == null { return null; }
  v
}

fn main() {
  a: vector<text> = [];
  for x in arguments() { a += [x]; }
  if len(a) < 2 {
    println("usage: gen_heights <block.store> <grid.hgt>");
    return;
  }
  path = a[0] ?? "";
  gpath = a[1] ?? "";
  if !file(path).exists() { println("#H FAIL no block at {path}"); return; }
  if !file(gpath).exists() { println("#H FAIL no height grid at {gpath} (tools/pack_terrain.py)"); return; }

  b: hash<TTile[tkey]> = [];
  bound = store_persist_bind(b, path);
  if !bound { println("#H FAIL could not bind {path}"); return; }

  // ⚠ ITERATE, and the reason is the WRITE, not a bug. The loop variable of a bound store's own hash is a
  // LIVE VIEW, so `t.steps[i] = …` writes through to the file — which is what makes this an in-place edit
  // rather than a copier. Proven directly: a step written in one run reads back changed in the next.
  // (Narrower than it sounds — the "iteration yields copies" rule (loft C86) still bites on an inner
  // collection walked for its scalar and text fields. Here the record's vector is shared, so it lands.)
  //
  // This comment used to forbid a keyed lookup outright, because `b.roads[k]` on a bound store ABORTED
  // the runtime (loft#739, `src/database/search.rs:229`). That is fixed as of 2026-08-03, so the
  // prohibition is gone — but nothing here wants a lookup anyway: every tile is visited.
  g = Grid { zoom: 0, x0: 0, y0: 0, cols: 0, rows: 0, present: [] };
  ntiles2 = 0;
  total = 0;
  filled = 0;
  hmin = 100000;
  hmax = 0 - 100000;

  {
    f = file(gpath);
    f#format = LittleEndian;
    magic = f#read(4) as text;
    if magic != "LTH1" {
      println("#H FAIL {gpath} is not a height grid (magic {magic})");
      return;
    }
    g.zoom = f#read as i32;
    g.x0 = f#read as i32;
    g.y0 = f#read as i32;
    g.cols = f#read as i32;
    g.rows = f#read as i32;
    ntiles = g.cols * g.rows;
    for _pi in 0..ntiles { g.present += [f#read as u8]; }
    npresent = 0;
    for pi2 in 0..len(g.present) { if (g.present[pi2] ?? 0) != 0 { npresent += 1; } }
    println("#H grid z{g.zoom} x{g.x0}+{g.cols} y{g.y0}+{g.rows} · {npresent}/{ntiles} tiles present");

    for t in b {
      ntiles2 += 1;
      ns = len(t.steps);
      for si in 0..ns {
        // Read x/y into scalars BEFORE writing the slot back: `h` is the only field this tool may change,
        // and a step whose x or y moved would move a road.
        vx = 0;
        vy = 0;
        if si < len(t.steps) {
          vx = t.steps[si].x as integer;
          vy = t.steps[si].y as integer;
        }
        total += 1;
        hh = grid_h(f, g, ((t.oy + vy) as float) / UNIT, ((t.ox + vx) as float) / UNIT);
        if hh != null {
          // `TStep.h` is binding-const, so the record is REPLACED rather than assigned into. `steps` is a
          // builder field (`const steps: vector<TStep>`), which permits exactly this.
          t.steps[si] = TStep { x: vx as i32? ?? (0 as i32), y: vy as i32? ?? (0 as i32),
                                h: hh as i32? ?? (0 as i32) };
          filled += 1;
          if hh < hmin { hmin = hh; }
          if hh > hmax { hmax = hh; }
        }
      }
    }
  }

  pct = 0.0;
  if total > 0 { pct = (filled as float) * 100.0 / (total as float) ?? 0.0; }
  println("#H tiles={ntiles2} steps={total} filled={filled} ({pct:4.1}%)");
  if filled > 0 { println("#H height min={hmin}m max={hmax}m"); }
  // A block where nothing was sampled is a failure, not an empty result: it means the grid is for the
  // wrong area or the wrong zoom, and the block would publish looking finished.
  if filled == 0 { println("#H FAIL no step got a height — does {gpath} cover this block?"); }
}
