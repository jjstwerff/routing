//
// PLAN-BUILD — the shared base-map kernel logic, target-independent (no store loading, so it compiles
// on every backend incl. --native-wasm). Both front-ends reuse it: `client/basemap_kernel.loft` loads
// the stores from a path (`store_load`, native/WASI) and `client/web_basemap_kernel.loft` loads them
// from a URL (`store_load_url`, --html); each then calls `do_view` / `do_view_bbox` / `do_match` here.
//   view [<mnla,mnlo,mxla,mxlo>]  → base map (A cover;… · B name;… · L kind;name;… · P kind;name;lat,lon
//                                   · N rank;name;lat,lon · S name;… street label · R class;… road).
//                                   With a bbox, only features overlapping it are emitted (viewport view):
//                                   whole-region view is ~230k lines and blocks a browser, so the page
//                                   requests the visible bbox — the emit volume, not the store, is the cost.
//   match <sketch> <profile>      → ROUTE lat,lon;… + SUMMARY ways=… len=…m  (server.loft's match_for path)

use basemap::(Coord, Area, Building, Line, Poi, Label, PTile, to_fixed, NameRec, fold_name,
              cell_ix, tier_cell, tier_key, LAYOUT_TIERS);
use routing_kernel::(GeoPoint, Way, TTile, TRoad, TStep, Barrier, Graph, MatchState, MatchQuality,
                     RF_ACCESS_NO, RF_FOOT_YES, RF_NET_WALK, RF_NET_CYCLE, RF_NET_MTB,
                     BF_FOOT_NO, BF_BIKE_NO, bbox_cell_keys,
                     tiles_corridor_ways, tiles_corridor_ways_streamed, tiles_corridor_ways_tube_streamed,
                     tiles_corridor_barriers, build_graph, build_graph_streamed, build_graph_barriers,
                     build_graph_barriers_streamed, match_route, corridor_margin, path_length_m,
                     point_polyline_m, match_state_new, match_incremental, match_incremental_streamed,
                     match_state_result, match_quality, tier_ok, TIER_TUBE, TIER_BBOX);

fn deg(fixed: integer) -> float { (fixed as float) / 10000000.0 }

fn class_name(tp: integer) -> text {
  if tp == 0 { "motorway" } else if tp == 1 { "primary" } else if tp == 2 { "secondary" }
  else if tp == 3 { "tertiary" } else if tp == 4 { "residential" } else if tp == 5 { "residential" }
  else if tp == 6 { "service" } else if tp == 7 { "cycle" } else if tp == 8 { "path" }
  else if tp == 9 { "foot" } else if tp == 10 { "pedestrian" } else if tp == 11 { "foot" }
  // ⚠ EVERY CLASS `class_of` CAN EMIT NEEDS A CASE HERE, and the `else` is why that is easy to miss.
  // 12/13/14 had none, so they fell through to "residential": a farm TRACK was drawn as a white street
  // and the `track` style the store change was made for (166ddc8, minZoom 14) was unreachable dead code.
  // The fallback made it invisible — an unnamed class does not vanish, it silently becomes a suburb road.
  // tools/map_render_gate.sh now requires an explicit case per class, not merely a name that resolves.
  else if tp == 12 { "track" } else if tp == 13 { "busway" } else if tp == 14 { "platform" }
  else { "residential" }
}

fn ring_text(pre: text, ox: integer, oy: integer, ring: vector<Coord>) -> text {
  line = pre;
  for c in ring { line += ";{deg(oy + (c.y as integer)):2.6},{deg(ox + (c.x as integer)):2.6}"; }
  line
}

// --- viewport bbox (fixed-point deg*1e7) --------------------------------------------------------------
// A query box in the same fixed-point space as the tile coords (oy+c.y = lat, ox+c.x = lon), so the
// overlap test is integer arithmetic. An empty/invalid spec yields a world box (everything passes).
struct FBox { const mnla: integer, const mnlo: integer, const mxla: integer, const mxlo: integer }

fn world_box() -> FBox { FBox { mnla: -900000000, mnlo: -1800000000, mxla: 900000000, mxlo: 1800000000 } }

fn parse_fbox(spec: text) -> FBox {
  p = spec.split(',');
  if len(p) != 4 { return world_box(); }
  a = p[0] as float?; b = p[1] as float?; c = p[2] as float?; d = p[3] as float?;
  if a == null || b == null || c == null || d == null { return world_box(); }
  FBox { mnla: to_fixed(a ?? 0.0), mnlo: to_fixed(b ?? 0.0), mxla: to_fixed(c ?? 0.0), mxlo: to_fixed(d ?? 0.0) }
}

// A ring/geometry (in tile-relative Coords) overlaps the box iff its fixed-point bbox intersects it.
fn ring_hits(ox: integer, oy: integer, ring: vector<Coord>, box: FBox) -> boolean {
  if len(ring) == 0 { return false; }
  first = true; rmnla = 0; rmxla = 0; rmnlo = 0; rmxlo = 0;
  for c in ring {
    la = oy + (c.y as integer); lo = ox + (c.x as integer);
    if first { rmnla = la; rmxla = la; rmnlo = lo; rmxlo = lo; first = false; }
    else { if la < rmnla { rmnla = la; } if la > rmxla { rmxla = la; }
           if lo < rmnlo { rmnlo = lo; } if lo > rmxlo { rmxlo = lo; } }
  }
  rmxla >= box.mnla && rmnla <= box.mxla && rmxlo >= box.mnlo && rmnlo <= box.mxlo
}

fn pt_hits(ox: integer, oy: integer, at: Coord, box: FBox) -> boolean {
  la = oy + (at.y as integer); lo = ox + (at.x as integer);
  la >= box.mnla && la <= box.mxla && lo >= box.mnlo && lo <= box.mxlo
}

// --- view: each layer in its own function (a single function with all loops trips a loft codegen bug) ---
fn emit_areas(layout: hash<PTile[tkey]>, box: FBox) -> integer {
  n = 0; for t in layout { for ar in t.areas { if ring_hits(t.ox, t.oy, ar.ring, box) { println(ring_text("A {ar.cover}", t.ox, t.oy, ar.ring)); n += 1; } } } n
}
fn emit_buildings(layout: hash<PTile[tkey]>, box: FBox) -> integer {
  n = 0; for t in layout { for b in t.buildings { if ring_hits(t.ox, t.oy, b.ring, box) { println(ring_text("B {b.name}", t.ox, t.oy, b.ring)); n += 1; } } } n
}
fn emit_lines(layout: hash<PTile[tkey]>, box: FBox) -> integer {
  n = 0; for t in layout { for ln in t.lines { if ring_hits(t.ox, t.oy, ln.geom, box) { println(ring_text("L {ln.kind};{ln.name}", t.ox, t.oy, ln.geom)); n += 1; } } } n
}
fn emit_pois(layout: hash<PTile[tkey]>, box: FBox) -> integer {
  n = 0; for t in layout { for p in t.pois { if pt_hits(t.ox, t.oy, p.at, box) { println("P {p.kind};{p.name};{deg(t.oy + (p.at.y as integer)):2.6},{deg(t.ox + (p.at.x as integer)):2.6}"); n += 1; } } } n
}
fn emit_labels(layout: hash<PTile[tkey]>, box: FBox) -> integer {
  n = 0;
  for t in layout {
    for lb in t.labels {
      if lb.kind == "street" {
        if ring_hits(t.ox, t.oy, lb.line, box) { println(ring_text("S {lb.name}", t.ox, t.oy, lb.line)); n += 1; }
      } else {
        c = lb.line[0] ?? Coord { x: 0 as i32, y: 0 as i32 };
        if pt_hits(t.ox, t.oy, c, box) { println("N {lb.rank};{lb.name};{deg(t.oy + (c.y as integer)):2.6},{deg(t.ox + (c.x as integer)):2.6}"); n += 1; }
      }
    }
  }
  n
}
// Barrier NODES — a locked gate is a node, so nothing in the way stream can carry it, and the map drew
// nothing at all where the router severs a crossing. They come out of the ROADS store, which the view
// already reads: the block has held them since #30 (`TTile.barriers`), so showing them costs no base-map
// rebuild and no schema change, only a line the reader did not have before.
//
// `G lat,lon,flags` — flags so the renderer can distinguish a gate that stops walking from a bollard that
// only stops cars, which is most of them. A map that marked every bollard as a wall would be more wrong
// than one that marked none.
fn emit_barriers(roads: hash<TTile[tkey]>, box: FBox) -> integer {
  n = 0;
  for t in roads {
    for b in t.barriers {
      la = t.oy + (b.y as integer); lo = t.ox + (b.x as integer);
      if la >= box.mnla && la <= box.mxla && lo >= box.mnlo && lo <= box.mxlo {
        println("G {deg(la):2.6},{deg(lo):2.6},{b.flags as integer}");
        n += 1;
      }
    }
  }
  n
}

fn emit_roads(roads: hash<TTile[tkey]>, box: FBox) -> integer {
  n = 0;
  for t in roads {
    si = 0;
    for r in t.roads {
      cnt = r.steps as integer;
      first = true; rmnla = 0; rmxla = 0; rmnlo = 0; rmxlo = 0;
      for k in 0..cnt {
        s = t.steps[si + k];
        if s != null {
          la = t.oy + (s.y as integer); lo = t.ox + (s.x as integer);
          if first { rmnla = la; rmxla = la; rmnlo = lo; rmxlo = lo; first = false; }
          else { if la < rmnla { rmnla = la; } if la > rmxla { rmxla = la; }
                 if lo < rmnlo { rmnlo = lo; } if lo > rmxlo { rmxlo = lo; } }
        }
      }
      hit = !first && rmxla >= box.mnla && rmnla <= box.mxla && rmxlo >= box.mnlo && rmnlo <= box.mxlo;
      if hit {
        // A CLOSED way is marked in the class field, `path|x`, rather than in a new column: the R line's
        // grammar is `class;lat,lon;…` and the reader already interns whatever `class` says, so a suffix
        // costs no parser change on either side and no new array — the reader splits it into one bit.
        //
        // "Closed" is the router's own test, not merely `access=no`: an `access=no` way carrying
        // `foot=yes` is legally walkable, and tools/access_gate.sh routes 341 m over exactly that. Marking
        // on the raw bit would have painted those barred while the router happily used them — a map
        // disagreeing with its own router is worse than one that says nothing.
        fl = r.flags as integer;
        shut = (fl & RF_ACCESS_NO) != 0 && (fl & RF_FOOT_YES) == 0;
        // SIGNPOSTED-NETWORK MEMBERSHIP rides the same suffix, for the same reason `|x` does: the class
        // field is already a token the reader splits on `|`, so `path|xw` costs no new column and no
        // second array. A way can be in several networks at once (a canal towpath is walk AND cycle), so
        // the letters accumulate — w = hiking/foot, c = bicycle, m = mtb, matching RF_NET_*.
        //
        // The bits are already in every shipped block: nl-east alone carries 121 185 walk, 67 938 cycle
        // and 12 158 mtb ways. Only the wire was missing them.
        marks = if shut { "x" } else { "" };
        if (fl & RF_NET_WALK) != 0 { marks += "w"; }
        if (fl & RF_NET_CYCLE) != 0 { marks += "c"; }
        if (fl & RF_NET_MTB) != 0 { marks += "m"; }
        // ⚠ Built OUTSIDE the interpolation. `"{if c { "|{marks}" } else { "" }}"` does not expand the
        // inner one — it puts the literal `|{marks}` on the wire, and the reader then matched the `m` in
        // "marks" and reported an mtb network that did not exist.
        sfx = "";
        if marks != "" { sfx = "|{marks}"; }
        line = "R {class_name(r.tp as integer)}{sfx}";
        for k in 0..cnt { s = t.steps[si + k]; if s != null { line += ";{deg(t.oy + (s.y as integer)):2.6},{deg(t.ox + (s.x as integer)):2.6}"; } }
        println(line); n += 1;
      }
      si += cnt;
    }
  }
  n
}

// Emit the base map for a loaded layout + roads store, restricted to `box` (a viewport). Text → println.
fn emit_view(layout: hash<PTile[tkey]>, roads: hash<TTile[tkey]>, box: FBox) {
  na = emit_areas(layout, box); nb = emit_buildings(layout, box); nl = emit_lines(layout, box);
  npo = emit_pois(layout, box); nlab = emit_labels(layout, box); nr = emit_roads(roads, box);
  ng = emit_barriers(roads, box);
  println("# view: A={na} B={nb} L={nl} P={npo} labels={nlab} R={nr} G={ng}");
}

// Whole-region view (every feature).
pub fn do_view(layout: hash<PTile[tkey]>, roads: hash<TTile[tkey]>) {
  emit_view(layout, roads, world_box());
}

// Viewport view: only features overlapping `bbox` ("mnla,mnlo,mxla,mxlo"; empty → whole region).
pub fn do_view_bbox(layout: hash<PTile[tkey]>, roads: hash<TTile[tkey]>, bbox: text) {
  emit_view(layout, roads, parse_fbox(bbox));
}

// ROADS-ONLY viewport view — what the browser front-end asks for since PLAN-PERF §0 step 13. The layout
// is read by JS straight out of the exposed store (@PLN105), so loft neither serialises it (~658 ms of a
// throttled view) nor WALKS it — and not walking it is what lets `expose` stay pinned for the whole
// session instead of being released and re-flattened per view (§7f, ~420 ms more).
//
// Roads still come over as text: the roads store is not exposed, and `match` — not the map — is what
// reads it. `client/basemap_kernel.loft` (native CLI) keeps calling `do_view_bbox` for the full emit,
// and the browser keeps it reachable as `viewtext` so the parity gate has something to compare against.
// The road cells a `view <bbox>` will read — so a PAGED consumer can fetch exactly those first
// (PLAN-SCALE C1b). Same parse as `do_view_roads_bbox` so the fetch list cannot drift from the read.
pub fn view_cell_keys(bbox: text) -> vector<integer> {
  vb = parse_fbox(bbox);
  bbox_cell_keys(vb.mnla, vb.mnlo, vb.mxla, vb.mxlo)
}

// The BASE MAP's fetch list — the layout counterpart of `view_cell_keys` (PLAN-SCALE §6f F1).
//
// It cannot BE `view_cell_keys`: the two stores are on different grids. Roads are keyed at
// `routing_kernel`'s TILE_CELL (0.02° ≈ 2 km) with its fixed packing; the layout at `LAYOUT_CELL`
// (~500 m) with basemap's parametric one. Handing one store the other's keys does not fail — it looks
// up keys that exist in neither and silently returns an empty map.
//
// ⚠ `pad` IS A SOUNDNESS CONDITION, not a tuning knob — and since PLAN-SCALE §6f F3 it is a condition
// the DATA satisfies rather than one this side has to guess at.
//
// The problem it answers: a layout feature is never clipped, so it reaches out of the tile it is keyed
// in. A WHOLE load still draws it (the render path screens on each tile's sealed extent); a PAGED load
// cannot, because a tile that was never fetched has no extent to consult, and its features are simply
// absent from the picture. When features were keyed by their FIRST VERTEX at one cell size, that reach
// was unbounded, and `tools/layout_page_probe.loft` measured what covering it would cost on nl-west:
// ELEVEN cells of padding for a z16 viewport of Amsterdam (864 tiles) and FIFTY for a z14 one (13 661 —
// the region). Exactness was not reachable by padding at all; pad=1 was a knee that still dropped a
// handful of very wide features (a province border, a power line, a big water body).
//
// The generator now bins each feature at the finest tier where its bbox spans AT MOST 2 CELLS
// (`basemap::layout_tier`), keyed at the cell holding the bbox's MINIMUM CORNER. So a feature occupies
// its own cell and at most the next one UP in each axis — never the one below. One cell of padding on
// the LOW side, per tier, is therefore exactly enough, and the reader takes every tier's window because
// a feature that did not fit a fine cell is on a coarse one.
pub const LAYOUT_PAD = 1;

pub fn layout_cell_keys(bbox: text, pad: integer) -> vector<integer> {
  lkeys: vector<integer> = [];
  // A paged store has no "whole region" view: an empty spec parses to the WORLD box, and enumerating the
  // world at 500 m cells is 2.6 billion keys. The app always sends a viewport; anything else asks for
  // nothing rather than for everything.
  if len(bbox.split(',')) != 4 { return lkeys; }
  lb = parse_fbox(bbox);
  ltier = 0;
  while ltier < LAYOUT_TIERS {
    lc = tier_cell(ltier);
    // Low side only — a feature keyed at cell c is drawn in c..c+1, so it is visible here iff
    // c >= x0 - 1 and c <= x1. Padding the high side too would ask for a ring of cells that cannot hold
    // anything this viewport can see, and an empty answer is not a cheap one.
    lx0 = cell_ix(lb.mnlo, lc) - pad; lx1 = cell_ix(lb.mxlo, lc);
    ly0 = cell_ix(lb.mnla, lc) - pad; ly1 = cell_ix(lb.mxla, lc);
    lyy = ly0;
    while lyy <= ly1 {
      lxx = lx0;
      while lxx <= lx1 { lkeys += [tier_key(ltier, lxx, lyy)]; lxx += 1; }
      lyy += 1;
    }
    ltier += 1;
  }
  lkeys
}

pub fn do_view_roads_bbox(roads: hash<TTile[tkey]>, bbox: text) {
  fbox = parse_fbox(bbox);
  nr = emit_roads(roads, fbox); ng = emit_barriers(roads, fbox);
  println("# view: R={nr} G={ng}");
}

// Parse a rough sketch "lat,lon;lat,lon;…" into GeoPoints (bad tokens skipped).
pub fn parse_sketch(spec: text) -> vector<GeoPoint> {
  pts: vector<GeoPoint> = [];
  for tok in spec.split(';') {
    xy = tok.split(',');
    if len(xy) == 2 { pts += [GeoPoint { lat: xy[0] as float ?? 0.0, lon: xy[1] as float ?? 0.0 }]; }
  }
  pts
}

// Map-match the rough sketch to the actual route over roads.store (server.loft's match_for path).
// Emits `ROUTE lat,lon;…` then a `SUMMARY` line. One-shot: builds the corridor and graph every call.
// A long-lived front-end should use `do_match_session` instead — see below.
pub fn do_match(roads: hash<TTile[tkey]>, trace: vector<GeoPoint>, profile: text) {
  if len(trace) < 2 { println("SUMMARY error=need>=2pts"); return; }
  osm = corridor_margin(trace);
  ways = tiles_corridor_ways(roads, trace, osm);
  // `tiles_corridor_ways` is the FAT (bbox) read, so its barriers must be read the same way — tube=false.
  // Reading them with the other tier would leave a gate missing exactly where the corridor is widest.
  route = match_route(build_graph_barriers(ways, tiles_corridor_barriers(roads, trace, osm, false)),
                      trace, profile);
  emit_route(route, len(ways), profile);
}

fn emit_route(route: vector<GeoPoint>, nways: integer, profile: text) {
  line = "ROUTE";
  for p in route { line += ";{p.lat:2.6},{p.lon:2.6}"; }
  println(line);
  println("SUMMARY ways={nways} route_pts={len(route)} len={path_length_m(route):1.1}m profile={profile}");
}

// --- session-scoped matching (PLAN-PERF §0 step 7) ----------------------------------------------------
// The corridor ways and the graph built from them are the SAME for every click that stays inside the
// area already fetched — so a session holds them instead of rebuilding per click. `build_graph` is ~41%
// of a cold match (PLAN-MATCH's table splits 886 ms as build 367 + search 519), and it was being paid
// on every single point the user added.
//
// This is `server/server.loft`'s cache, ported rather than reinvented: `covs` records each corridor's
// footprint and `covered()` asks whether every point of the new sketch lies well inside one we already
// have. Keep the two in step — the server is the reference implementation.

struct Corridor { pts: vector<GeoPoint>, margin: float }
// `tier` is which corridor the session holds: TIER_TUBE (the cheap cell-tube) or TIER_BBOX (the fat
// rectangle, §3's floor). It exists so the gate can be re-applied to a WARM edit as well as a cold one —
// a warm edit reuses the accepted graph and can drift to where the tube has no ways, so acceptance has
// to be re-earned rather than inherited from the match that first built the corridor.
pub struct MatchSession { cways: vector<Way>, cg: Graph, covs: vector<Corridor>, mstate: MatchState, built: boolean, tier: integer }


pub fn session_new() -> MatchSession {
  MatchSession { cways: [], cg: build_graph([]), covs: [], mstate: match_state_new(), built: false, tier: TIER_BBOX }
}

// True when EVERY point lies well inside SOME corridor this session already built — so the accumulated
// graph already holds the ways it needs and nothing must be rebuilt. The 0.85 / 1.05 factors are the
// server's: require the point comfortably inside (not at the fringe, where the corridor's own ways run
// out) and the new margin no wider than the one that was fetched.
fn covered(s: MatchSession, pts: vector<GeoPoint>, margin: float) -> boolean {
  if !s.built || len(s.cways) == 0 || len(s.covs) == 0 { return false; }
  for p in pts {
    ok = false;
    for c in s.covs {
      if margin <= c.margin * 1.05 && point_polyline_m(p, c.pts) <= c.margin * 0.85 { ok = true; break; }
    }
    if !ok { return false; }
  }
  true
}

// Match `trace`, reusing the session's graph when the sketch is already covered.
//
// A miss REPLACES the corridor — it does not accumulate. This is server.loft's policy verbatim, and its
// reason is load-bearing: "The tile block is complete for the corridor, so use it AS THE graph — no
// accumulation. … Accumulating tile corridors instead would grow the graph without bound as the user
// pans (each miss rebuilding an ever-bigger build_graph — RSS and latency blow up), so tiles replace."
// Re-reading a tile corridor is local and cheap; an unbounded graph is neither. (Overpass corridors DO
// accumulate in server.loft, because a re-fetch is a ~12 s network round-trip — this kernel has no
// Overpass path, so that branch does not apply here.)
// INCREMENTAL (PLAN-PERF §0 step 8): `match_incremental` diffs `trace` against the cached MatchState and
// recomputes only the edited window — a moved point re-searches a handful of stretches, not the whole
// route. On a miss the corridor is rebuilt and the state re-seeded from scratch (a fresh graph invalidates
// every anchor), which is exactly what server.loft does: `match_incremental(match_state_new(), g, …)`.
//
// This is the one step here that could silently change what the user gets, so the gate is equality, not
// speed: match_state_result(cg, match_incremental(…)) must equal match_route(cg, trace) byte-for-byte.
// tools/match_parity.sh asserts it.
pub fn do_match_session(s: MatchSession, roads: hash<TTile[tkey]>, trace: vector<GeoPoint>, profile: text) {
  do_match_session_streamed(s, roads, trace, profile, drop_stretch_out, drop_tick_out);
}

fn drop_stretch_out(_i: integer, _pts: vector<GeoPoint>) { }
fn drop_tick_out(_n: integer) { }

// Emit ONE stretch as `STRETCH <i>;lat,lon;…` the moment it is matched. A caller that wants the route
// to appear as a growing line passes `on_stretch` (PLAN-PERF §6b A) — typically a closure that emits
// this and then hands the frame back, so the page paints between stretches instead of stalling for the
// whole route. Kept out of this library: `frame_yield` is browser-only, and map_kernel must compile on
// every backend (app_kernel builds it for --native-wasm).
pub fn emit_stretch(i: integer, pts: vector<GeoPoint>) {
  line = "STRETCH {i}";
  for p in pts { line += ";{p.lat:2.6},{p.lon:2.6}"; }
  println(line);
}

// As `do_match_session`, but reports each stretch through `on_stretch` as it lands.
pub fn do_match_session_streamed(s: MatchSession, roads: hash<TTile[tkey]>, trace: vector<GeoPoint>,
                                 profile: text, on_stretch: fn(integer, vector<GeoPoint>),
                                 on_tick: fn(integer)) {
  if len(trace) < 2 { println("SUMMARY error=need>=2pts"); return; }
  margin = corridor_margin(trace);
  // Captured BEFORE the rebuild, because building the tube sets `covered` true for the next call — the
  // gate has to know whether THIS match is the one that just chose a tier.
  covered_before = covered(s, trace, margin);
  if !covered_before {
    // TIER 1 — the cell tube (PLAN-PERF steps 20/22): only the tiles near the polyline, not every tile
    // in its bbox rectangle. ~65% fewer ways, so the corridor read, build_graph AND the search all
    // shrink. Kept only if the gate below accepts it.
    //
    // The REBUILD is the other un-interruptible block: streaming the stretches left the corridor read
    // and build_graph as one ~11s freeze on a cold match (PLAN-PERF §6b A). Yield inside both.
    s.cways = tiles_corridor_ways_tube_streamed(roads, trace, margin, on_tick);
    s.cg = build_graph_barriers_streamed(s.cways, tiles_corridor_barriers(roads, trace, margin, true), on_tick);
    s.covs = [Corridor { pts: trace, margin: margin }];
    s.mstate = match_state_new();     // fresh graph ⇒ every cached anchor is stale
    s.built = true;
    s.tier = TIER_TUBE;
  }
  s.mstate = match_incremental_streamed(s.mstate, s.cg, trace, profile, on_stretch, on_tick);

  // THE GATE (PLAN-MATCH §3), applied to the match that JUST BUILT the tube — the cold path only.
  //
  // Not to warm edits, deliberately. `covered()` already requires every point of the new sketch to lie
  // within `margin * 0.85` of a corridor this session built, so a warm edit that is covered is by
  // construction inside the tube that was accepted; re-gating it can only re-derive the same answer.
  // Gating warm edits was tried and is what a first measurement showed as a 4.6x spread on the warm
  // number: an edit that tripped the threshold turned a ~700 ms incremental match into a full corridor
  // rebuild. `covered()` is the warm-path guard; the gate is for choosing a tier at build time.
  //
  // Escalation REPLACES the corridor and re-matches from a fresh state, so the session ends holding the
  // tier that was actually accepted — a later warm edit continues from the fat corridor, and the tube is
  // not retried until the next corridor miss. The fat corridor is always the floor: the gate can only
  // make us spend more, never accept something this rebuild would have improved on.
  if s.tier == TIER_TUBE && !covered_before {
    if !tier_ok(match_quality(s.mstate, trace, match_state_result(s.cg, s.mstate)), margin) {
      s.cways = tiles_corridor_ways_streamed(roads, trace, margin, on_tick);
      s.cg = build_graph_barriers_streamed(s.cways, tiles_corridor_barriers(roads, trace, margin, false), on_tick);
      s.mstate = match_incremental_streamed(match_state_new(), s.cg, trace, profile, on_stretch, on_tick);
      s.tier = TIER_BBOX;
    }
  }
  emit_route(match_state_result(s.cg, s.mstate).pts, len(s.cways), profile);
}

// ===================================================================================================
// SEARCH — "where is Lonneker", answered from our own files (PLAN-RESTORE R4).
//
// The old client sent this to Nominatim. Nothing here leaves the machine: the names come from the same
// OSM extract the roads do, in a store of their own (`tools/gen-names.loft`), and the whole Netherlands
// is 34.4 MB of it.
//
// A LINEAR SCAN, deliberately. A B-tree `index<NameRec[fold]>` would answer a prefix faster, but the
// query people actually type is a SUBSTRING ("kerk" for Kerkstraat, "lonn" for Lonneker) and no ordered
// index helps with that.
//
// ⚠ IT IS WALKED BY KEY, NOT WITH `for r in names`. Hash iteration yields COPIES (loft C86), and a copy
// of a NameRec copies its two `text` fields — so the obvious loop duplicated 618 000 strings per
// keystroke and took **5.4 s natively** on the country store. `names[i]` is a live view instead, and the
// ids are dense 0..n-1 by construction (`gen-names` assigns them in insertion order), so the walk is a
// plain counted loop that ends at the first missing id. Same answers, no copies.

// How well `q` matches `fold`, or -1 for no match. Higher is better, and the tiers are the distinctions a
// person would make: what they typed IS the name, the name STARTS with it, a WORD in the name starts
// with it, or it merely appears somewhere.
pub fn name_score(fold: text, q: text) -> integer {
  if q == "" { return 0 - 1; }
  at = fold.find(q);
  if at < 0 { return 0 - 1; }
  if fold.size() == q.size() { return 3; }
  if at == 0 { return 2; }
  // A word boundary — "straat" should rank higher in "Kerk Straat" than inside "Verstraatweg".
  before = fold[(at - 1)..at];
  if before == " " || before == "-" || before == "'" { return 1; }
  0
}

// One search result, ordered by what a person means: the best MATCH first, then the most significant
// PLACE, then the nearest. Distance last on purpose — a city 40 km away is a better answer for "Amster"
// than a hamlet 2 km away, and only ties should be broken by proximity.
pub struct NameHit { const score: integer, const rank: integer, const dist2: integer, const rec: integer }

// Squared distance in fixed-point degrees, longitude scaled for latitude. Squared and integer because it
// is only ever COMPARED — a metric that never has to be reported does not need a square root or a
// geodesic, and this one has to run 309 157 times.
fn near2(alat: integer, alon: integer, blat: integer, blon: integer) -> integer {
  dla = alat - blat;
  dlo = ((alon - blon) * 6) / 10;      // cos(52 deg) ~ 0.6 — the band this data covers
  (dla * dla) + (dlo * dlo)
}

// `find`: emit at most `limit` matches for `q`, nearest-and-best first, as
//   FOUND <lat>,<lon> <kind> <rank> <name>
// Coordinates in degrees, so the caller can centre the map on one without knowing the store's unit.
pub fn do_find(names: hash<NameRec[id]>, q: text, clat: float, clon: float, limit: integer) {
  fq = fold_name(q);
  if fq == "" { println("FOUNDCOUNT 0"); return; }
  cla = round(clat * 10000000.0) as integer;
  clo = round(clon * 10000000.0) as integer;

  // Keep only the best `limit` as we go: a full sort of 309k records to show 8 answers would be the
  // expensive half of this operation, and an insertion into a short list is not.
  best: vector<NameHit> = [];
  i = 0;
  while true {
    r = names[i];
    if r == null { break; }
    i = i + 1;
    sc = name_score(r.fold, fq);
    if sc < 0 { continue; }
    d = near2(r.lat as integer, r.lon as integer, cla, clo);
    rk = r.rank as integer;
    // Worse than everything already held, and the list is full — the common case, so it is first.
    if len(best) >= limit {
      w = best[len(best) - 1] ?? NameHit { score: 9, rank: 9, dist2: 0, rec: 0 };
      if sc < w.score { continue; }
      if sc == w.score && rk < w.rank { continue; }
      if sc == w.score && rk == w.rank && d >= w.dist2 { continue; }
    }
    // Insertion sort into a list that is at most `limit` long. Built fresh rather than shuffled in
    // place: swapping struct elements through a temp is the #338 trap (`tmp = v[j]` is a VIEW of the
    // slot, `v[j] = v[k]` is a COPY into it), and a list this short makes the safe form free.
    next: vector<NameHit> = [];
    placed = false;
    for h in best {
      if !placed && (sc > h.score
                     || (sc == h.score && rk > h.rank)
                     || (sc == h.score && rk == h.rank && d < h.dist2)) {
        next += [NameHit { score: sc, rank: rk, dist2: d, rec: r.id }];
        placed = true;
      }
      if len(next) < limit { next += [h]; }
    }
    if !placed && len(next) < limit { next += [NameHit { score: sc, rank: rk, dist2: d, rec: r.id }]; }
    best = next;
  }

  println("FOUNDCOUNT {len(best)}");
  for h in best {
    rec = names[h.rec];
    if rec == null { continue; }
    la = (rec.lat as integer) as float / 10000000.0;
    lo = (rec.lon as integer) as float / 10000000.0;
    println("FOUND {la:1.7},{lo:1.7} {rec.kind as integer} {rec.rank as integer} {rec.name}");
  }
}
