// Copyright (c) 2026 Jurjen Stellingwerff
// SPDX-License-Identifier: LGPL-3.0-or-later
//
// PLAN-BUILD B4/B5 — the BROWSER front-end of the base-map kernel (`loft --html`). Same shared
// `map_kernel` view/match logic as `client/basemap_kernel.loft`, but the browser has no filesystem or
// argv, so it loads the two stores straight from a URL with `store_load_url_trusted` (the fetch is
// bridged to JS `fetch()` in wasm) and takes its command over the host_input()/println channel.
//
// `main` is a COMMAND LOOP, reading one blob per pass. Today JS still pushes one blob per `loft_start`,
// so it runs a single pass and returns — but the loop is the seam the session work goes through
// (PLAN-PERF §0 steps 5–8): a `main` that never returns is a `loft_start` that never rebuilds the
// stores, so the decoded stores, the Graph and the MatchState survive across clicks instead of being
// rebuilt for each. `tools/loop_probe.sh` proves loft can hold that state and still yield the frame.
// (store_load_url is --html-only — it does NOT compile to --native-wasm/WASI, which is why this is a
// separate file from the path-loading `basemap_kernel.loft`.)
//
// Input framing — one host_input() blob per command, newline-separated (JS sets globalThis.loftInput
// before loft_start; step 5 adds loftPush for subsequent commands):
//   line 0: <layout.store URLs — the covering SET, comma-separated>
//   line 1: <roads.store URL>
//   line 2: view | match
//   line 3: view → <bbox "mnla,mnlo,mxla,mxlo"> (empty = whole region);  match → <sketch "lat,lon;…">
//   line 4: <profile e.g. cycling_road>    (match only)
//   line 5: <roads read mode: paged | whole>
//   line 6: <names.store URL>              (find only)
//   line 7: <base-map read mode: paged | whole>   (PLAN-SCALE §6f F1; absent ⇒ whole, i.e. pre-F1)
// Output: the same A/B/L/P/N/S/R view lines or ROUTE/SUMMARY over println. The page requests `view <bbox>`
// for the visible extent — whole-region view is ~230k lines and would block the browser thread.

use map_kernel::(do_view_bbox, do_view_roads_bbox, do_match_session_streamed, session_new, parse_sketch, emit_stretch, view_cell_keys, layout_cell_keys, LAYOUT_PAD, do_find);
use basemap::(PTile, NameRec);
use routing_kernel::(TTile, GeoPoint, corridor_cell_keys, corridor_margin);
use web::frame_yield;

// PLAN-SCALE C1b — one mark per cell key this session has already asked the host for. A paged loader
// signals "no such key" exactly as it signals "nothing loaded", so without this a cell that genuinely
// holds no roads would be re-fetched on every single command. Marked BEFORE the fetch, and never
// cleared except when the region changes.
struct CellMark { const k: integer }

// Which of `keys` this session has not asked the host for yet. READ-ONLY on purpose — the marking and
// the fetch happen at the call site, on the loop's own locals, for two reasons that are both loft's:
//   * `marks += …` through a `&hash` parameter does not compile — the checker reads the append as a
//     reassignment of the reference itself. (A BY-VALUE hash param does propagate appends, so a helper
//     is possible; it is inline here because the fetch also needs `roads`, which must stay a bare local.)
//   * and the store CANNOT live in a struct field to be passed as one — the paged loaders refuse a
//     field-declared collection (loft#632), which is the whole mechanism this path runs on.
// So the caller keeps both collections as bare locals and this only decides what is missing.
// `base` is the caller's ALREADY-MULTIPLIED block offset, not a block number. The two stores mark on
// different strides (a layout key carries its tier, so it needs a wider one), and a helper that applied
// one stride to both would silently answer the layout's question with the roads' arithmetic.
fn cells_to_fetch(marks: hash<CellMark[k]>, keys: vector<integer>, base: integer) -> vector<integer> {
  need: vector<integer> = [];
  for k in keys { if marks[base + k] == null { need += [k]; } }
  need
}

// One mark per (BLOCK, cell), not per cell. Blocks are disjoint by cell, so a key lives in exactly one of
// them — and every covering block gets asked for the whole window, so a block that legitimately returns
// nothing for a key must not mark it fetched for its neighbour. The multiplier is far above any cell key
// (the packing tops out around 1.6e8 for the whole world at this cell size).
MARK_BLOCK = 10000000000;

// The layout's own mark stride, and it CANNOT be MARK_BLOCK. A layout key carries its tier in the high
// digits (`basemap::TIER_STRIDE` is 1e10), so the top tier's keys reach ~4.3e10 — past the roads stride,
// which would make block 4's cell 0 collide with block 0's tier-4 cells. This sits above any layout key
// at any tier, with room for the tier ladder to grow.
LMARK_BLOCK = 1000000000000;

// End-of-response marker. `loft_start` never returns now, so the host cannot use "the call returned" as
// "this command is done" — it needs an in-band terminator. A bare `#EOR` line can only come from here:
// every map line carries a type prefix (A/B/L/P/N/S/R) and the summaries are `# view:` / `SUMMARY`.
EOR = "#EOR";

// The tag JS looks the layout handle up under (`__storeKernel.exposedValue(EXPOSE_LAYOUT)`).
EXPOSE_LAYOUT = 1;

// The command loop. Today JS pushes exactly one blob per `loft_start`, so this runs a single pass and
// then returns on the empty read — byte-identical behaviour to the one-shot form it replaces. It is a
// loop because the loads and the state they produce are about to be hoisted ABOVE it (PLAN-PERF §0
// steps 6–8): once `main` no longer returns between commands, `loft_start` cannot rebuild the stores,
// and the Graph/MatchState survive from one click to the next. Structure first, behaviour later.
//
// No `frame_yield()` here yet: yielding pulls in the `loft_web.ws_yield` host import, which the page's
// shim does not provide until it drives the loop (step 5). Until then the empty read means "JS is done
// with this call", not "wait for more".
// Emit a stretch, then yield: the host sees `STRETCH i;…` and can paint before the next one lands.
fn stream_stretch(i: integer, pts: vector<GeoPoint>) {
  emit_stretch(i, pts);
  frame_yield();
}

// Nothing to show mid-rebuild — just hand the frame back so the page keeps painting while the corridor
// is read and the graph built (the ~11s block streaming the stretches did not cover).
fn tick_yield(_n: integer) { frame_yield(); }

fn main() {
  // SESSION STATE — declared above the loop, so it outlives the command that filled it. Inside the
  // loop these declarations would re-initialise to `[]` on every pass, which is the stateless app in
  // miniature. `main` never returns, so loft_start never re-enters and never rebuilds them.
  // PLAN-SCALE C1b: `roads` is no longer the whole block — it is the WORKING SET, grown by
  // `store_load_keys` as commands ask for cells. A paged load ACCUMULATES (verified), so a session pays
  // for each cell once and a warm edit inside the loaded area fetches nothing at all.
  roads: hash<TTile[tkey]> = [];
  marks: hash<CellMark[k]> = [];
  // PLAN-SCALE §6f F1 — the base map is a WORKING SET too, on its own grid. A country's layout store is
  // ~690 MB, so "load it whole" is what made the map blank outside Enschede: it was left on a release
  // the browser cannot read rather than cut down to what a screen needs. `lmarks` is `marks`' twin for
  // the layout's cell keys — same reason (a paged loader reports "no such key" exactly as it reports
  // "loaded nothing", so an empty cell would be re-requested by every command for the rest of the
  // session), and separate because the two stores key on different grids at different cell sizes.
  layout: hash<PTile[tkey]> = [];
  lmarks: hash<CellMark[k]> = [];
  // Which URL each store currently holds ("" = empty). The URLs arrive IN the command, so the loads
  // cannot literally precede the loop — this is the equivalent: load on first use, reuse after, and
  // reload only if the command names a different region. Re-validating a static 20 MB image on every
  // pan was ~341 ms of the 1121 ms pan (PLAN-PERF §2).
  roads_at  = "";
  layout_at = "";
  // PLAN-RESTORE R4 — the searchable names, held like the other stores: loaded on first `find` and
  // reused. 34.4 MB for the whole Netherlands (296 457 street names + 12 700 places), so it is read
  // WHOLE rather than paged: a substring search touches every record by definition, and paging a store
  // you are about to scan end to end is strictly worse than fetching it once.
  names: hash<NameRec[id]> = [];
  names_at  = "";
  // The corridor ways + the graph built from them, held across commands: identical for every click that
  // stays inside the area already fetched, so rebuilding per click was ~41% of a match wasted
  // (PLAN-PERF §0 step 7). Reset when the roads store changes — a new region invalidates the corridor.
  sess = session_new();
  // Is the layout store currently PINNED by `expose` (PLAN-PERF §0 step 9)? Tracked rather than inferred,
  // because `release` must only ever be called against a live pin — and because loft must not touch the
  // store while one is in force (see the view branch below for why).
  layout_pinned = false;
  while true {
    blob = host_input();
    if blob == "" {
      // Gather-until-enough: no command queued. Hand the frame back and poll again — the load-bearing
      // rule is that "blocking" yields, never hard-spins, so the page keeps painting while we wait
      // (BROWSER_INTEROP.md; tools/loop_probe.sh proves the shape).
      frame_yield();
    } else {
      lines = blob.split('\n');
      // PLAN-SCALE §6f F3 — line 0 is the COVERING SET of base blocks, not one block. NL is cut into
      // three base regions to fit a host each, and a viewport ON a cut needs both sides: measured at the
      // 4.90°E seam, one region answers a straddling z16 viewport with 13 946 of its 25 862 features.
      // Paging is what allows it — `store_load_keys` accumulates, where the whole-file load this
      // replaced adopted an image and a second one would have discarded the first.
      layout_url = lines[0] ?? "";
      // PLAN-SCALE C2 — line 1 is the COVERING SET, not a block: a comma-separated list of the roads
      // blocks whose extent this command touches. One entry is the C0/C1 case and behaves exactly as
      // before; a corridor near a border names two, and the working set is filled from each in turn
      // (S8 proved the matcher cannot tell — `store_load_keys` accumulates).
      roads_url  = lines[1] ?? "";
      cmd        = lines[2] ?? "view";
      arg3       = lines[3] ?? "";                // bbox (view) or sketch (match)
      profile    = lines[4] ?? "cycling_road";
      // PLAN-SCALE C1b — how to READ the roads block. "paged" pulls only the cells a command touches
      // (store_load_keys over HTTP Range); anything else loads the block whole, which is what a SMALL
      // block wants. Measured on this 3.5 MB block: a session that pans and matches across the region
      // fetches 44-80% of the bytes ANYWAY, in 25-46 separate requests, because the block is only ~56
      // pages wide. On localhost those requests are nearly free; over a real RTT they are 25-46 round
      // trips against one. So the strategy belongs to the DATA, not to the code — at C2 the top index
      // carries it per block, and paging wins as soon as a viewport is a small fraction of a block.
      readmode   = lines[5] ?? "whole";
      // Line 7, appended rather than folded into an existing slot: this protocol is POSITIONAL, so
      // reusing the layout or profile line would have made every existing command's meaning depend on
      // which command it was. Absent for every command except `find`, and empty is a valid answer there
      // (a region with no name store simply finds nothing).
      names_url  = lines[6] ?? "";
      // How to read the BASE MAP, per store rather than per region (HANDOFF §0 rule 2): NL ships roads
      // beside the app and its base map somewhere else, so the two stores do not have to be read the
      // same way. Absent ⇒ "whole", which is the pre-F1 behaviour and what a 20 MB city block wants.
      // Line 7 is the BASE read mode, optionally carrying the block's tier floor as `paged:N` — the
      // finest tier that store actually holds (§6i O3b). A bare `paged` is floor 0, which is what every
      // detailed block sends and exactly the behaviour this replaces.
      lmode_raw  = lines[7] ?? "whole";
      lmode_bits = lmode_raw.split(':');
      lmode      = lmode_bits[0] ?? "whole";
      lfloor     = if len(lmode_bits) > 1 { (lmode_bits[1] ?? "0") as integer ?? 0 } else { 0 };
      roads_urls: vector<text> = [];
      for u in roads_url.split(',') { if u != "" { roads_urls += [u]; } }
      layout_urls: vector<text> = [];
      for lu in layout_url.split(',') { if lu != "" { layout_urls += [lu]; } }
      // More than one base block can only be PAGED, for the same reason the roads set can only be: a
      // whole-file load adopts an image and the second would replace the first, where a keyed load adds.
      if len(layout_urls) > 1 { lmode = "paged"; }
      // More than one block can only be PAGED. A whole-file load adopts an image — the second would
      // replace the first rather than add to it — whereas `store_load_keys` accumulates by design. So
      // the covering set decides the strategy when it is plural, and the per-block hint decides when it
      // is not (a single small block is still cheaper whole; PLAN-SCALE C1b).
      if len(roads_urls) > 1 { readmode = "paged"; }

      ok = true;
      // A changed URL means a different region: the working set, its marks and the cached corridor are
      // all stale. In "paged" mode nothing is fetched here — each command below asks for the cells it is
      // about to read. In "whole" mode the block is loaded once, exactly as before C1b.
      // A changed covering SET means different data underfoot: the working set, its marks and the
      // cached corridor are all stale. `roads_at` holds the whole set, so gaining a second block
      // invalidates as surely as changing region does.
      if roads_url != roads_at {
        roads = [];
        marks = [];
        sess = session_new();
        if roads_url == "" {
          // A VIEW WITH NO ROADS STORE — supported, not an error, and the same shape line 1 already has
          // for a region with no base map. Below the handover zoom the map is the overview block alone
          // (PLAN-SCALE §6i O1): its road spine is stored as LINES inside it, already merged and
          // decimated, so reading the detailed roads there would be asking ~70 000 cell keys to draw the
          // motorways a single 19.6 MB file already holds. Measured before this branch existed: 75 256
          // range requests and 4.7 GB into one block, and the view never returned.
          roads_at = "";
        } else if readmode == "paged" {
          roads_at = roads_url;
        } else if len(roads_urls) == 1 && store_load_url_trusted(roads, roads_urls[0] ?? "") {
          roads_at = roads_url;
        } else {
          println("ERR roads store_load_url failed: {roads_url}");
          roads_at = "";                          // a failed load leaves the store unusable — don't cache it
          ok = false;
        }
      }
      if ok {
        if cmd == "find" {
          // PLAN-RESTORE R4. Needs neither the layout nor the roads: it reads its own store, so it is
          // handled before either is touched — a search must work in a region that has no base map at
          // all, which after N3 is most of the country.
          //
          // arg3 is "<lat>,<lon>,<query>": the camera first so results can be ordered by proximity, and
          // the query LAST so a name containing a comma survives (everything after the second one).
          if names_url != "" && names_url != names_at {
            if store_load_url_trusted(names, names_url) {
              names_at = names_url;
            } else {
              println("ERR names store_load_url failed: {names_url}");
              names_at = "";
            }
          }
          fla = 0.0; flo = 0.0; fq = arg3;
          c1 = arg3.find(",");
          if c1 > 0 {
            rest1 = arg3[(c1 + 1)..arg3.size()];
            c2 = rest1.find(",");
            if c2 > 0 {
              fla = arg3[0..c1] as float ?? 0.0;
              flo = rest1[0..c2] as float ?? 0.0;
              fq = rest1[(c2 + 1)..rest1.size()];
            }
          }
          do_find(names, fq, fla, flo, 8);
        } else if cmd == "lazyprobe" {
          // @PLN129 arc A, in the browser — DOES A LOOKUP FETCH?
          //
          // Every other read here has to be TOLD what to fetch: `store_load_keys` takes the cell keys a
          // command decided it needs, which is why the app carries a covering set, a page index, a
          // prefetch batch and a ring — and why a cell nobody predicted is silently missing rather than
          // fetched. A lazy bind inverts that: the collection starts empty and a MISS goes to the source.
          //
          // Bound to a FRESH collection each pass, so the probe cannot be answered by a previous one's
          // residency. `arg3` carries the keys because JS never computes a `tkey` — only loft does.
          // The record type is the PROFILE slot, because a probe has no profile and the protocol is
          // positional: "base" walks PTile (the layout grid), anything else TTile (roads). The base
          // store is the one that matters most — a cold Amsterdam view read 43.3 MB of base against
          // 6.7 MB of roads — and its grid is finer, so a viewport names far more cells.
          lz: hash<TTile[tkey]> = [];
          lzp: hash<PTile[tkey]> = [];
          lurl = roads_urls[0] ?? "";
          lzbase = profile == "base";
          bound = if lzbase { store_bind_lazy(lzp, lurl) } else { store_bind_lazy(lz, lurl) };
          got = 0;
          miss = 0;
          for lzk in arg3.split(',') {
            if lzk != "" {
              lzkey = lzk as integer ?? 0;
              if lzbase {
                lzptile = lzp[lzkey];
                if lzptile == null { miss += 1; } else { got += 1; }
              } else {
                lztile = lz[lzkey];
                if lztile == null { miss += 1; } else { got += 1; }
              }
            }
          }
          // `faults` counts fetches that could not REACH the source — 0 is healthy — and `err` tells an
          // unreachable source apart from a genuinely absent key. That distinction is the one the app
          // has been unable to make: a range read that fails leaves a hole the view records as held.
          lzfaults = if lzbase { store_lazy_faults(lzp) } else { store_lazy_faults(lz) };
          lzerr = if lzbase { store_lazy_error(lzp) } else { store_lazy_error(lz) };
          println("LAZY bound={bound} got={got} miss={miss} faults={lzfaults} err='{lzerr}' url={lurl}");
        } else if cmd == "keysprobe" {
          // The BASELINE the lazy probe has to be read against: the same keys through the path the app
          // uses today. `store_load_keys` is told everything up front and fetches it as one batch, which
          // is exactly what lazy binding gives up — so the comparison is bytes and reads, not features.
          kp: hash<TTile[tkey]> = [];
          kpp: hash<PTile[tkey]> = [];
          kpkeys: vector<integer> = [];
          for kpk in arg3.split(',') { if kpk != "" { kpkeys += [kpk as integer ?? 0]; } }
          kpurl = roads_urls[0] ?? "";
          kpn = if profile == "base" { store_load_keys(kpp, kpurl, kpkeys) }
                else { store_load_keys(kp, kpurl, kpkeys) };
          println("KEYSLOAD asked={len(kpkeys)} loaded={kpn}");
        } else if cmd == "reset" {
          // Profiler hook (PLAN-PERF §7e). The session is what makes a warm edit cheap — and it is also
          // what makes a "cold" measurement impossible once it exists: re-sending the same sketch into a
          // live session measures the nothing-changed case, not a cold match. Dropping the session is the
          // only way to time a genuinely cold one without also re-fetching the stores (which would charge
          // the match a 355 ms decode it never pays in real use). Costs nothing when unused.
          sess = session_new();
        } else if cmd == "match" {
          // Stream the route: emit each stretch as it is matched, then hand the frame back. The page
          // draws a line that GROWS instead of freezing for the whole match (PLAN-PERF §6b A). This is
          // the only layer that may yield — frame_yield is browser-only, and map_kernel/routing_kernel
          // must compile on every backend.
          // Fetch what this match will read, before it reads it. The FAT window (tube = false) on
          // purpose: it is a superset of the cell tube, so an escalation inside the ladder cannot find a
          // cell missing — and a missing cell does not fail, it silently routes around roads that exist.
          mpts = parse_sketch(arg3);
          if len(mpts) >= 2 {
            mkeys: vector<integer> = [];
            if readmode == "paged" { mkeys = corridor_cell_keys(mpts, corridor_margin(mpts), false); }
            bi = 0;
            for burl in roads_urls {
              // Ask EVERY covering block for the window. A block that holds none of these cells returns
              // nothing and costs one request; a corridor near a seam gets its cells from both (S8).
              bneed: vector<integer> = cells_to_fetch(marks, mkeys, bi * MARK_BLOCK);
              if len(bneed) > 0 {
                // Mark BEFORE fetching, and leave the mark even when the key turns out to be absent from
                // THIS block: a paged loader reports "no such key" exactly as it reports "loaded
                // nothing", so an empty cell would otherwise be re-requested by every command for the
                // rest of the session.
                for nk in bneed { marks += CellMark { k: bi * MARK_BLOCK + nk }; }
                // A corridor is a window like any other: one unreadable page must not cost the route
                // every cell it could have had. See the view's roads loop for what this is worth.
                mbn = store_load_keys(roads, burl, bneed);
                if mbn == 0 && len(bneed) > 1 {
                  for mbk in bneed {
                    mbone: vector<integer> = [mbk];
                    _ = store_load_keys(roads, burl, mbone);
                  }
                }
              }
              bi += 1;
            }

          }
          do_match_session_streamed(sess, roads, mpts, profile, stream_stretch, tick_yield);
        } else {
          // @PLN105 steps 9-13 — the layout store is EXPOSED to JS, which reads its PTiles straight out
          // of wasm memory. loft no longer serialises the layout at all: `view` emits roads only.
          //
          // The pin must not be in force while loft itself TOUCHES the store — `expose` locks it
          // read-only, and both a (re)load (which writes) and an iteration (which claims a cursor record
          // INSIDE the pinned store — `Claim on read-only store (size=546)`, §7d(2)) are rejected under
          // it. In wasm that rejection is a silent trap, which is what hung step 9's first attempt.
          //
          // Only two things still touch it, so only they unpin:
          //   * a store (re)load — writes;
          //   * `viewtext`, the full text emit, kept ONLY so the parity gate has a reference to compare
          //     the JS-read layers against. The app never sends it.
          // A plain `view` touches nothing, so the pin SURVIVES the whole session: one `expose` at load
          // rather than one per view. That is §7f's ~420 ms, and it is why deleting the emit was worth
          // more than the serialize time it saved.
          if layout_pinned && (cmd == "viewtext" || layout_url != layout_at) {
            release(EXPOSE_LAYOUT, layout);
            layout_pinned = false;
          }
          if layout_url != layout_at {
            // A changed URL is a different region: the working set and its marks describe the old one.
            layout = [];
            lmarks = [];
            if layout_url == "" {
              layout_at = "";                     // a region with no base map — supported, not an error
            } else if lmode == "paged" {
              // PLAN-SCALE §6f F1 — nothing is fetched HERE: the view below asks for exactly the cells
              // it is about to read. This is the roads' own treatment (C1b), one grid finer.
              layout_at = layout_url;
            } else if len(layout_urls) == 1 && store_load_url_trusted(layout, layout_urls[0] ?? "") {
              layout_at = layout_url;
            } else {
              println("ERR layout store_load_url failed: {layout_url}");
              layout_at = "";
              ok = false;
            }
          }
          if ok {
            // F1 — the base-map cells this viewport reads, in the LAYOUT's key space (~500 m cells),
            // which is not the roads' (2 km). Paged mode only: a whole-loaded store holds them already.
            lkeys: vector<integer> = [];
            // The base read mode may carry the block's TIER FLOOR as `paged:N` — the finest tier the
            // store holds. Below it every key is provably absent, and an absent key still costs pages
            // (§6i O3b: 2388 wasted asks on one z13 viewport, 169.6 MB against 43.7). A bare `paged` is
            // floor 0, which is every detailed block and the behaviour this replaces.
            if lmode == "paged" && layout_at != "" { lkeys = layout_cell_keys(arg3, LAYOUT_PAD, lfloor); }
            lbi = 0;
            for lburl in layout_urls {
              // Ask EVERY covering base block for the window, exactly as the roads loop below does. A
              // block holding none of these cells returns nothing and costs one request; a viewport on a
              // seam gets its cells from both sides.
              lbneed: vector<integer> = cells_to_fetch(lmarks, lkeys, lbi * LMARK_BLOCK);
              if len(lbneed) > 0 {
                // F2 — the pin comes OFF and goes back ON around every growth of the working set.
                // `expose` pins the store read-only and a load WRITES, so loading under the pin is
                // rejected — in wasm silently, as a trap (§7d(2)). The pin used to be taken once per
                // session and never disturbed, because after the initial whole load nothing touched the
                // store again; a paged base map touches it on every viewport that reaches new ground.
                // What makes that safe on the other side is that JS re-reads the handle after EVERY
                // command (browser/store-app.mjs re-fetches `exposedValue(1)` per view) — it must, since
                // a `memory.grow` during the call detaches its ArrayBuffer anyway.
                if layout_pinned { release(EXPOSE_LAYOUT, layout); layout_pinned = false; }
                // Marked BEFORE the fetch, and the mark stays even when the cell turns out to be absent
                // from THIS block: a paged loader reports "no such key" exactly as it reports "loaded
                // nothing", so an empty cell would otherwise be re-requested for the rest of the session.
                for lk in lbneed { lmarks += CellMark { k: lbi * LMARK_BLOCK + lk }; }
                // Same rule for the base map — see the roads loop below. The layout is the larger half of
                // a cold view, so an all-or-nothing window here is the difference between a drawn town
                // and a blank one.
                lbn = store_load_keys(layout, lburl, lbneed);
                if lbn == 0 && len(lbneed) > 1 {
                  for lbk in lbneed {
                    lbone: vector<integer> = [lbk];
                    _ = store_load_keys(layout, lburl, lbone);
                  }
                }
              }
              lbi += 1;
            }
            vkeys: vector<integer> = [];
            if readmode == "paged" { vkeys = view_cell_keys(arg3); }
            vbi = 0;
            for vburl in roads_urls {
              // Ask EVERY covering block for the window. A block that holds none of these cells returns
              // nothing and costs one request; a corridor near a seam gets its cells from both (S8).
              vbneed: vector<integer> = cells_to_fetch(marks, vkeys, vbi * MARK_BLOCK);
              if len(vbneed) > 0 {
                // Mark BEFORE fetching, and leave the mark even when the key turns out to be absent from
                // THIS block: a paged loader reports "no such key" exactly as it reports "loaded
                // nothing", so an empty cell would otherwise be re-requested by every command for the
                // rest of the session.
                for nk in vbneed { marks += CellMark { k: vbi * MARK_BLOCK + nk }; }
                // ⚠ A WINDOW IS ONE CALL, AND ONE UNREADABLE PAGE TAKES ALL OF IT. Measured offline with
                // a saved route: 855 pages served from the device and the view still drew NOTHING —
                // `R=0 G=0 T=0` — because a handful of pages in the second covering block could not be
                // read and the whole batch came back empty. A blank map is the worst possible answer
                // there: the person is on the route, holding a device that HAS most of the map.
                //
                // So a batch that loads nothing is retried cell by cell. The failures stay failures and
                // everything else loads, which is the difference between a map with a hole and no map.
                // It costs nothing when the batch succeeds, which is every online read.
                vbn = store_load_keys(roads, vburl, vbneed);
                if vbn == 0 && len(vbneed) > 1 {
                  for vbk in vbneed {
                    vbone: vector<integer> = [vbk];
                    _ = store_load_keys(roads, vburl, vbone);
                  }
                }
              }
              vbi += 1;
            }

            if cmd == "viewtext" {
              do_view_bbox(layout, roads, arg3);
            } else {
              do_view_roads_bbox(roads, arg3);
            }
            if !layout_pinned {
              expose(EXPOSE_LAYOUT, layout);
              layout_pinned = true;
            }
          }
        }
      }
      // Terminate the response on EVERY path, errors included — a host waiting on this marker must
      // never be left hanging by a failed load.
      println(EOR);
    }
  }
}
