//
// PLAN-BASEMAP S5.5 — the full presentation-store builder. Reads the four extracted fixtures (areas,
// buildings, places, streets) and bins ALL of them into ONE hash<PTile[tkey]> at the presentation cell,
// then persists → reloads → verifies → round-trips every count. Areas/buildings store footprint rings;
// place nodes become point Labels (rank-tiered); named streets become Labels with a DP-simplified
// centerline (option B). Lines/pois are allowed by the schema but need their own fixtures (S5.5b).
//   loft --interpret --path <loft>/ --lib lib client/basemap/build_store.loft \
//        <areas.json> <buildings.json> <places.json> <streets.json> [out.store]

#cwd

use basemap::(Coord, Area, Building, Line, Poi, Label, PTile, area_use, area_label_kind, place_rank, line_kind, poi_kind, dp_mask,
              to_fixed, cell_ix, origin, layout_tier, tier_cell, tier_key);

// Local atag — a JsonValue does not survive being passed into a LIB (cross-package) function, so the
// tag reader must live in this file. (Reading scalar/nested fields off a locally-held JsonValue is fine.)
fn atag(obj: JsonValue, name: text) -> text {
  v = obj.field(name);
  if v.kind() == "JString" { v.as_text() } else { "" }
}

// The grid this store is keyed on lives in `basemap` — `LAYOUT_CELL` and the tier ladder built from it
// (`layout_tier` / `tier_cell` / `tier_key`), which `map_kernel::layout_cell_keys` reads it back with.
// It is deliberately NOT a parameter here any more: a generator binning on one grid and a client paging
// on another does not fail, it looks up keys that exist in neither and silently draws nothing.
STREET_EPS = 10.0;     // metres — street centerline simplification tolerance


// --- PLAN-SCALE S6, base half: plain-data binning, shared by both input paths -----------------------
//
// The six loops below used to read Overpass JSON and bin in one breath, which is why the whole document
// had to be resident. Each layer now has a `bin_*` that takes PLAIN DATA — the tags already read, the
// geometry already converted — so a streaming reader can feed it one feature at a time and the two paths
// cannot drift (the same lesson `gen-tiles` learned: one binning function, two readers).
//
// Plain data is also a constraint, not a preference: a JsonValue does not survive being passed into a
// cross-package function (see `atag` above), so geometry crosses these boundaries as `LL`, never as JSON.
struct LL { lat: float, lon: float }

// Ensure the tile a FEATURE belongs in exists, and return its KEY.
//
// PLAN-SCALE §6f F3 — the tile is chosen from the feature's whole BBOX, not from its first vertex alone:
// `layout_tier` picks the finest tier whose cells the bbox spans at most 2 of, and the feature is then
// keyed at that tier's cell containing its first vertex. That is what bounds a feature's reach to ONE
// cell at its own tier, which is what makes a reader's one-cell window exact instead of a guess (see
// `basemap::layout_tier`). Binning by the first vertex alone let a province border sit in a 500 m tile
// and reach 50 cells out of it, and a paged reader had no way to know.
//
// ⚠ It returns a key, not the tile, and that is load-bearing: a whole-value bind COPIES a heap value
// (loft C86), so a `-> PTile` version compiles, runs, creates every tile — and every append lands in the
// copy. The first draft did exactly that and produced 1089 tiles holding 0 areas, 0 buildings, 0 labels:
// a store that looks structurally right and is empty. Each caller re-reads `idx[key]`, which is a live
// view into the store.
fn ensure_tile(idx: hash<PTile[tkey]>, pts: vector<LL>) -> integer {
  p0 = pts[0] ?? LL { lat: 0.0, lon: 0.0 };
  mnlo = to_fixed(p0.lon); mxlo = mnlo; mnla = to_fixed(p0.lat); mxla = mnla;
  for p in pts {
    px = to_fixed(p.lon); py = to_fixed(p.lat);
    if px < mnlo { mnlo = px; } if px > mxlo { mxlo = px; }
    if py < mnla { mnla = py; } if py > mxla { mxla = py; }
  }
  tier = layout_tier(mnlo, mnla, mxlo, mxla);
  cell = tier_cell(tier);
  // The MINIMUM CORNER of the bbox, not the first vertex: the feature then occupies this cell and at
  // most the next one up in each axis, never the one below, so the reader pads on one side instead of
  // two (see `basemap::layout_tier`). The first vertex is an arbitrary corner of the geometry and gives
  // no such bound.
  tx = cell_ix(mnlo, cell); ty = cell_ix(mnla, cell);
  key = tier_key(tier, tx, ty);
  if idx[key] == null {
    idx += PTile { tkey: key, ox: origin(tx, cell), oy: origin(ty, cell), areas: [], buildings: [], lines: [], labels: [], pois: [] };
  }
  key
}

fn ring_of(t: PTile, pts: vector<LL>) -> vector<Coord> {
  r: vector<Coord> = [];
  for p in pts {
    r += [Coord { x: (to_fixed(p.lon) - t.ox) as i32? ?? (0 as i32), y: (to_fixed(p.lat) - t.oy) as i32? ?? (0 as i32) }];
  }
  r
}

fn bin_area(idx: hash<PTile[tkey]>, cover: text, pts: vector<LL>) {
  if len(pts) < 3 { return; }
  t = idx[ensure_tile(idx, pts)];
  if t != null { t.areas += [Area { cover: cover, ring: ring_of(t, pts) }]; }
}

fn bin_building(idx: hash<PTile[tkey]>, name: text, pts: vector<LL>) {
  if len(pts) < 4 { return; }
  t = idx[ensure_tile(idx, pts)];
  if t != null { t.buildings += [Building { name: name, ring: ring_of(t, pts) }]; }
}

fn bin_place(idx: hash<PTile[tkey]>, name: text, kind: text, rank: integer, at: LL) {
  if rank <= 0 || name == "" { return; }
  t = idx[ensure_tile(idx, [at])];
  if t != null { t.labels += [Label { name: name, kind: kind, rank: rank, line: ring_of(t, [at]) }]; }
}

fn bin_street(idx: hash<PTile[tkey]>, label: text, pts: vector<LL>) {
  if label == "" || len(pts) < 2 { return; }
  p0 = pts[0] ?? LL { lat: 0.0, lon: 0.0 };
  mlon = 111320.0 * cos(p0.lat * (PI / 180.0));
  xs: vector<float> = []; ys: vector<float> = [];
  for p in pts { xs += [(p.lon - p0.lon) * mlon]; ys += [(p.lat - p0.lat) * 111320.0]; }
  keep = dp_mask(xs, ys, STREET_EPS);
  kept: vector<LL> = [];
  for j in 0..len(pts) { if keep[j] ?? false { kept += [pts[j] ?? p0]; } }
  // The SIMPLIFIED line decides the tier, because it is what gets stored and therefore what a reader
  // has to be able to find; the dropped vertices cannot extend it.
  t = idx[ensure_tile(idx, kept)];
  if t != null { t.labels += [Label { name: label, kind: "street", rank: 0, line: ring_of(t, kept) }]; }
}

fn bin_line(idx: hash<PTile[tkey]>, kind: text, lname: text, pts: vector<LL>) {
  if kind == "" || len(pts) < 2 { return; }
  t = idx[ensure_tile(idx, pts)];
  if t != null { t.lines += [Line { kind: kind, name: lname, geom: ring_of(t, pts) }]; }
}

fn bin_poi(idx: hash<PTile[tkey]>, kind: text, name: text, at: LL) {
  if kind == "" { return; }
  t = idx[ensure_tile(idx, [at])];
  if t != null { t.pois += [Poi { kind: kind, name: name, at: ring_of(t, [at])[0] ?? Coord { x: 0 as i32, y: 0 as i32 } }]; }
}


// --- the streaming reader (PLAN-SCALE S6, base half) -----------------------------------------------
//
// `lines()` is built on `content()`, so both hold the whole file; the binary idiom seeks instead. Each
// pass reads a chunk, uses only the part up to its LAST newline, and seeks back to just after it — so a
// chunk boundary can never split a line, and a partial multi-byte character is never decoded. Memory is
// the chunk, whatever the file, which is what a country-sized base map needs.
//
// Layers: 0 areas · 1 buildings · 2 places · 3 streets · 4 lines · 5 pois.
fn feature_pts(geom: JsonValue) -> vector<LL> {
  pts: vector<LL> = [];
  gt = atag(geom, "type");
  cs = geom.field("coordinates");
  // osmium emits a MULTIPOLYGON for anything it assembles as an area — a closed tagged way OR a
  // multipolygon relation — a Polygon for the rarer single-ring form, and a LineString otherwise. All
  // three arrive on the same layer, so all three are unwrapped to one outer ring here.
  //
  // ⚠ MultiPolygon used to be missing, and it read as harmless: osmium emits a closed WAY twice, once as
  // a LineString and once as an area, so the LineString twin carried every way and the dropped twin was
  // a duplicate. A RELATION has no twin. Its member ways are untagged, so a `w/` filter never selects
  // them and the relation is the only object there is — which is how Medisch Spectrum Twente's 70615 m²
  // `building=hospital` (a 316-point relation) had no outline on the map at all. This block carries 122
  // building relations and 297 terrain relations; every one of them needed BOTH this and the `r/` filters
  // in tools/build-base.sh, which is why the two land together.
  ring = if gt == "MultiPolygon" { cs.item(0).item(0) }
         else if gt == "Polygon" { cs.item(0) }
         else { cs };
  if gt == "Point" {
    pts += [LL { lat: cs.item(1).as_number(), lon: cs.item(0).as_number() }];
    return pts;
  }
  for i in 0..len(ring) {
    pair = ring.item(i);
    if len(pair) >= 2 { pts += [LL { lat: pair.item(1).as_number(), lon: pair.item(0).as_number() }]; }
  }
  pts
}

// The centre of a ring's bounding box — where a designation's name belongs. Not a true centroid: a
// centroid needs the polygon's area integral, and for a label the box centre is both cheaper and more
// stable under the DP simplification the ring has already been through.
fn ring_centre(pts: vector<LL>) -> LL {
  p0 = pts[0] ?? LL { lat: 0.0, lon: 0.0 };
  mnla = p0.lat; mxla = p0.lat; mnlo = p0.lon; mxlo = p0.lon;
  for p in pts {
    if p.lat < mnla { mnla = p.lat; } if p.lat > mxla { mxla = p.lat; }
    if p.lon < mnlo { mnlo = p.lon; } if p.lon > mxlo { mxlo = p.lon; }
  }
  LL { lat: (mnla + mxla) / 2.0, lon: (mnlo + mxlo) / 2.0 }
}

fn bin_feature(idx: hash<PTile[tkey]>, layer: integer, line: text) {
  cut = 0 - 1;
  for ch in line { if ch == '{' { cut = ch#index; break; } }   // RFC 8142 record separator, if present
  if cut < 0 { return; }
  root = json_parse(line[cut..line.size()]);
  props = root.field("properties");
  pts = feature_pts(root.field("geometry"));
  if len(pts) < 1 { return; }
  at = pts[0] ?? LL { lat: 0.0, lon: 0.0 };
  if layer == 0 {
    cover = area_use(atag(props, "landuse"), atag(props, "natural"), atag(props, "leisure"),
                     atag(props, "amenity"), atag(props, "aeroway"));
    bin_area(idx, cover, pts);
    // A designation is drawn as an outline, so its NAME is the only thing that says what the outline is.
    // It rides the existing label collection (no schema change) at the ring's bbox centre — a place
    // label sits at one point, and a designation's first vertex is an arbitrary corner of it.
    // ⚠ THE RANK MUST BE POSITIVE. `bin_place` opens with `if rank <= 0 || name == "" { return; }` — the
    // guard that stops an untyped place from being labelled — so passing 0 here dropped every designation
    // name in silence. It was invisible in the output and visible in one number: `labels=` came back
    // IDENTICAL across a rebuild that was supposed to add them.
    aname = atag(props, "name");
    if (cover == "reserve" || cover == "site") && aname != "" {
      bin_place(idx, aname, cover, if cover == "reserve" { 3 } else { 2 }, ring_centre(pts));
    }
    // A park or a sports ground keeps its fill and gains a name — same label channel, same centre.
    lkind = area_label_kind(atag(props, "landuse"), atag(props, "leisure"), atag(props, "amenity"),
                            atag(props, "historic"));
    if lkind != "" && aname != "" {
      // Rank 3 for a castle — debut z12 and 11 px by RANK_MINZOOM/RANK_FONTPX, against a building name's
      // z16 and 10 px. It is the rank a nature reserve gets, which is the right company: something you
      // navigate by, sparse enough that 971 of them nationally cost nothing at low zoom.
      bin_place(idx, aname, lkind, if lkind == "castle" { 3 } else if lkind == "sports" { 1 } else { 2 },
                ring_centre(pts));
    }
  }
  else if layer == 1 { if atag(props, "building") != "" { bin_building(idx, atag(props, "name"), pts); } }
  else if layer == 2 { bin_place(idx, atag(props, "name"), atag(props, "place"), place_rank(atag(props, "place")), at); }
  else if layer == 3 {
    nm = atag(props, "name"); rf = atag(props, "ref");
    if atag(props, "highway") != "" { bin_street(idx, if nm != "" { nm } else { rf }, pts); }
  }
  else if layer == 4 { bin_line(idx, line_kind(atag(props, "waterway"), atag(props, "railway"), atag(props, "barrier"),
                                 atag(props, "aeroway"), atag(props, "boundary"),
                                 atag(props, "admin_level"), atag(props, "power")), atag(props, "name"), pts); }
  else { bin_poi(idx, poi_kind(atag(props, "natural"), atag(props, "amenity"), atag(props, "tourism"),
                                     atag(props, "man_made"), atag(props, "historic"), atag(props, "leisure"),
                                     atag(props, "highway"), atag(props, "power")), atag(props, "name"), at); }
}

// Build the whole store from six streamed layers. It CREATES the hash and returns it, mirroring
// `build_store`, rather than filling one the caller owns — see the note at the call site.
fn build_stream(p0: text, p1: text, p2: text, p3: text, p4: text, p5: text) -> hash<PTile[tkey]> {
  idx: hash<PTile[tkey]> = [];
  n0 = stream_layer(idx, p0, 0);
  n1 = stream_layer(idx, p1, 1);
  n2 = stream_layer(idx, p2, 2);
  n3 = stream_layer(idx, p3, 3);
  n4 = stream_layer(idx, p4, 4);
  n5 = stream_layer(idx, p5, 5);
  println("streamed features: areas={n0} buildings={n1} places={n2} streets={n3} lines={n4} pois={n5}");
  seal_extents(idx);
  idx
}

fn stream_layer(idx: hash<PTile[tkey]>, path: text, layer: integer) -> integer {
  f = file(path);
  total = f.size;
  pos = 0; chunk_size = 1048576; nlines = 0;
  while pos < total {
    f#next = pos;
    want = chunk_size;
    if pos + want > total { want = total - pos; }
    chunk = f#read(want) as text;
    last_nl = 0 - 1;
    for ch in chunk { if ch == '\n' { last_nl = ch#index; } }
    if last_nl < 0 {
      if pos + want >= total {
        if chunk != "" { bin_feature(idx, layer, chunk); nlines += 1; }
        pos = total;
      } else { chunk_size = chunk_size * 2; }
    } else {
      part = chunk[0..last_nl];
      for ln in part.split('\n') { if ln != "" { bin_feature(idx, layer, ln); nlines += 1; } }
      pos = pos + last_nl + 1;
    }
  }
  nlines
}

fn build_store(areas_osm: text, buildings_osm: text, places_osm: text, streets_osm: text, lines_osm: text, pois_osm: text) -> hash<PTile[tkey]> {
  idx: hash<PTile[tkey]> = [];

  // ⚠ THIS READER OWNS NO BINNING. It walks whole Overpass documents where `build_stream` walks
  // geojsonseq lines, and both hand the SAME `bin_*` functions plain `LL` geometry — which is what the
  // file header has always claimed and what `tools/base_stream_gate.sh` checks. It used to hand-roll its
  // own tile creation instead (`cell_ix` + `tkey` + a PTile literal, six times over), and the two
  // implementations had already drifted once: 11310 labels against 11312 on the same input.
  //
  // PLAN-SCALE §6f F3 made keeping them apart untenable rather than merely unwise. A feature's tile is
  // now chosen from its whole BBOX, so the tile cannot be resolved before the geometry has been read —
  // and every one of those hand-rolled loops resolved the tile FIRST, to subtract its origin while
  // reading. There is no version of the old shape that survives the tier rule.

  // --- areas: landcover polygons (+ a designation label for reserves/sites) ---
  ra = json_parse(areas_osm); ea = ra.field("elements");
  for i in 0..len(ea) {
    el = ea.item(i);
    if atag(el, "type") == "way" {
      geom = el.field("geometry"); m = len(geom);
      if m >= 3 {
        tags = el.field("tags");
        cover = area_use(atag(tags, "landuse"), atag(tags, "natural"), atag(tags, "leisure"),
                         atag(tags, "amenity"), atag(tags, "aeroway"));
        pts: vector<LL> = [];
        for j in 0..m { g = geom.item(j); pts += [LL { lat: g.field("lat").as_number(), lon: g.field("lon").as_number() }]; }
        bin_area(idx, cover, pts);
        aname = atag(tags, "name");
        if (cover == "reserve" || cover == "site") && aname != "" {
          bin_place(idx, aname, cover, if cover == "reserve" { 3 } else { 2 }, ring_centre(pts));
        }
        // ⚠ THE SECOND CALL SITE. The Overpass path and the geojsonseq path both classify area labels,
        // and a rule added to one only is worse than a rule in neither — the surviving copy looks
        // authoritative (HANDOFF §2, the area-debut ladder that lived in six copies). Ranks match above.
        alkind = area_label_kind(atag(tags, "landuse"), atag(tags, "leisure"), atag(tags, "amenity"),
                                 atag(tags, "historic"));
        if alkind != "" && aname != "" {
          bin_place(idx, aname, alkind, if alkind == "castle" { 3 } else if alkind == "sports" { 1 } else { 2 },
                    ring_centre(pts));
        }
      }
    }
  }

  // --- buildings: footprint polygons (+ optional name) ---
  rb = json_parse(buildings_osm); eb = rb.field("elements");
  for i in 0..len(eb) {
    el = eb.item(i);
    if atag(el, "type") == "way" {
      tags = el.field("tags");
      if atag(tags, "building") != "" {
        geom = el.field("geometry"); m = len(geom);
        if m >= 4 {
          pts: vector<LL> = [];
          for j in 0..m { g = geom.item(j); pts += [LL { lat: g.field("lat").as_number(), lon: g.field("lon").as_number() }]; }
          bin_building(idx, atag(tags, "name"), pts);
        }
      }
    }
  }

  // --- places: point Labels (city/town/village/... by rank) ---
  rp = json_parse(places_osm); ep = rp.field("elements");
  for i in 0..len(ep) {
    el = ep.item(i);
    if atag(el, "type") == "node" {
      tags = el.field("tags");
      kind = atag(tags, "place");
      bin_place(idx, atag(tags, "name"), kind, place_rank(kind),
                LL { lat: el.field("lat").as_number(), lon: el.field("lon").as_number() });
    }
  }

  // --- streets: name Labels with a DP-simplified centerline (option B) ---
  rs = json_parse(streets_osm); es = rs.field("elements");
  for i in 0..len(es) {
    el = es.item(i);
    if atag(el, "type") == "way" {
      tags = el.field("tags");
      name = atag(tags, "name"); ref = atag(tags, "ref"); hw = atag(tags, "highway");
      geom = el.field("geometry"); m = len(geom);
      if hw != "" && m >= 2 {
        pts: vector<LL> = [];
        for j in 0..m { g = geom.item(j); pts += [LL { lat: g.field("lat").as_number(), lon: g.field("lon").as_number() }]; }
        bin_street(idx, if name != "" { name } else { ref }, pts);   // motorways (A1) carry a ref, not a name
      }
    }
  }

  // --- lines: waterway / railway / barrier / border / power (stroked Line features) ---
  rl = json_parse(lines_osm); eln = rl.field("elements");
  for i in 0..len(eln) {
    el = eln.item(i);
    if atag(el, "type") == "way" {
      tags = el.field("tags");
      kind = line_kind(atag(tags, "waterway"), atag(tags, "railway"), atag(tags, "barrier"),
                       atag(tags, "aeroway"), atag(tags, "boundary"), atag(tags, "admin_level"),
                       atag(tags, "power"));
      geom = el.field("geometry"); m = len(geom);
      if kind != "" && m >= 2 {
        pts: vector<LL> = [];
        for j in 0..m { g = geom.item(j); pts += [LL { lat: g.field("lat").as_number(), lon: g.field("lon").as_number() }]; }
        bin_line(idx, kind, atag(tags, "name"), pts);
      }
    }
  }

  // --- pois: point features (nodes) ---
  rpo = json_parse(pois_osm); epo = rpo.field("elements");
  for i in 0..len(epo) {
    el = epo.item(i);
    if atag(el, "type") == "node" {
      tags = el.field("tags");
      bin_poi(idx, poi_kind(atag(tags, "natural"), atag(tags, "amenity"), atag(tags, "tourism"),
                            atag(tags, "man_made"), atag(tags, "historic"), atag(tags, "leisure"),
                            atag(tags, "highway"), atag(tags, "power")),
              atag(tags, "name"), LL { lat: el.field("lat").as_number(), lon: el.field("lon").as_number() });
    }
  }

  seal_extents(idx);
  idx
}
// Fold one coordinate into a tile's extent. `fcount` doubles as the "is it set yet" flag, so the first
// coordinate initialises rather than min/maxing against a zero that is not in the data.
fn note_extent(t: PTile, la: integer, lo: integer) {
  if t.fcount == 0 { t.fmnla = la; t.fmxla = la; t.fmnlo = lo; t.fmxlo = lo; }
  else {
    if la < t.fmnla { t.fmnla = la; }
    if la > t.fmxla { t.fmxla = la; }
    if lo < t.fmnlo { t.fmnlo = lo; }
    if lo > t.fmxlo { t.fmxlo = lo; }
  }
  t.fcount += 1;
}

// PLAN-PERF §7g — record each tile's ACTUAL feature extent, once the geometry vectors are complete.
// A separate pass rather than maintaining it at the six append sites: one place to be correct, and it
// cannot drift when a new feature kind is added (a missed append site would silently shrink the extent
// and start dropping features from the viewport).
fn seal_extents(idx: hash<PTile[tkey]>) {
  for t in idx {
    for sa in t.areas { for ca in sa.ring { note_extent(t, t.oy + (ca.y as integer), t.ox + (ca.x as integer)); } }
    for sb in t.buildings { for cb in sb.ring { note_extent(t, t.oy + (cb.y as integer), t.ox + (cb.x as integer)); } }
    for sl in t.lines { for cl in sl.geom { note_extent(t, t.oy + (cl.y as integer), t.ox + (cl.x as integer)); } }
    for sk in t.labels { for ck in sk.line { note_extent(t, t.oy + (ck.y as integer), t.ox + (ck.x as integer)); } }
    for sp in t.pois { note_extent(t, t.oy + (sp.at.y as integer), t.ox + (sp.at.x as integer)); }
  }
}

fn main() {
  a: vector<text> = [];
  for x in arguments() { a += [x]; }
  if len(a) < 6 { println("usage: build_store <areas.json> <buildings.json> <places.json> <streets.json> <lines.json> <pois.json> [out.store]"); return; }
  out_path = a[6] ?? "";

  // PLAN-SCALE S6 (base half) — the FORM of each input picks its reader, exactly as `gen-tiles` does.
  // A `.geojsonseq` layer is streamed line by line (one chunk resident, whatever the file); anything else
  // is the whole-document Overpass path this tool was born with. They share the same `bin_*` functions,
  // so a streamed layer and a whole-file one cannot produce different tiles.
  streamed = 0;
  for k in 0..6 {
    pth = a[k] ?? "";
    if pth.ends_with(".geojsonseq") || pth.ends_with(".jsonl") { streamed += 1; }
  }
  // ⚠ The store is built INSIDE `build_stream` and returned, exactly as the whole-file path does with
  // `build_store`. Filling a hash declared HERE produced a store whose tiles persisted while their
  // vectors did not — 1089 tiles reloading with 0 areas, 0 buildings, 0 labels, with persist/load/verify
  // all reporting true. In memory it was correct; only the image was empty.
  idx: hash<PTile[tkey]> = [];
  if streamed == 6 {
    idx = build_stream(a[0] ?? "", a[1] ?? "", a[2] ?? "", a[3] ?? "", a[4] ?? "", a[5] ?? "");
  } else if streamed > 0 {
    // Refused rather than half-honoured: a mixed invocation would silently read some layers whole, which
    // is the memory the streaming path exists to avoid, and the counts would not say which.
    println("ERR mixed inputs: {streamed} of 6 are .geojsonseq — give all six in one form");
    return;
  } else {
    idx = build_store(file(a[0] ?? "").content(), file(a[1] ?? "").content(), file(a[2] ?? "").content(),
                      file(a[3] ?? "").content(), file(a[4] ?? "").content(), file(a[5] ?? "").content());
  }

  nt = 0; na = 0; nb = 0; nl = 0; nln = 0; npo = 0; named_bld = false; a1 = false;
  for t in idx {
    nt += 1;
    for _ar in t.areas { na += 1; }
    for b in t.buildings { nb += 1; if b.name != "" { named_bld = true; } }
    for l in t.labels { nl += 1; if l.name == "A1" { a1 = true; } }
    for _ln in t.lines { nln += 1; }
    for _p in t.pois { npo += 1; }
  }
  println("tiles={nt} areas={na} buildings={nb} labels={nl} lines={nln} pois={npo} | named_building={named_bld} A1_label={a1}");

  if out_path != "" {
    // ⚠ Remove an existing image first. `store_persist_bind` BINDS to whatever is already at the path
    // rather than replacing it, so regenerating over a previous run's file can report persist/load/verify
    // all true and reload the OLD contents. That cost an hour here: a first draft wrote 1089 empty tiles
    // (a C86 copy bug), and every corrected run afterwards kept reloading those empty tiles from the file
    // the broken run had left behind — the fix looked like it had not worked.
    _ = delete(out_path);
    _ = delete("{out_path}.dschema");
    ok = store_persist_bind(idx, out_path);
    dst: hash<PTile[tkey]> = [];
    lok = store_load(dst, out_path);
    vok = store_verify(dst);
    nt2 = 0; na2 = 0; nb2 = 0; nl2 = 0; nln2 = 0; npo2 = 0;
    for t in dst {
      nt2 += 1;
      for _a in t.areas { na2 += 1; }
      for _b in t.buildings { nb2 += 1; }
      for _l in t.labels { nl2 += 1; }
      for _ln in t.lines { nln2 += 1; }
      for _p in t.pois { npo2 += 1; }
    }
    println("persist {ok} load {lok} verify {vok} | reloaded tiles={nt2} areas={na2} buildings={nb2} labels={nl2} lines={nln2} pois={npo2}");
    if ok && lok && vok && nt2 == nt && na2 == na && nb2 == nb && nl2 == nl && nln2 == nln && npo2 == npo {
      println("B0 OK: layout store (areas+buildings+lines+pois+labels) round-trips");
    } else {
      println("B0 FAIL");
    }
  }
}
